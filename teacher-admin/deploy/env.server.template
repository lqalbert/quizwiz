# 服务器运行时：复制到 /srv/quizwiz/teacher-admin/.env
# systemd 使用 EnvironmentFile= 指向该文件

API_PORT=3000
JWT_SECRET=REPLACE_WITH_LONG_RANDOM_SECRET

DATABASE_URL=postgresql://quizwiz_app:REPLACE_PASSWORD@127.0.0.1:5432/quizwiz

# 必须与 Nginx 对外域名一致（含 https、无末尾斜杠；若只用 www 子域，不要写裸域）
UPLOAD_PUBLIC_BASE=https://www.quizwiz.cn

# 须与 student-front/config/site.js 中 expectedMiniProgramAppId、project.config.json 的 appid 为同一小程序
WECHAT_MINI_APPID=
WECHAT_MINI_SECRET=
