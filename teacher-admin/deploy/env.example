# 复制本文件到 teacher-admin 目录并重命名为 .env（与 server/index.js 同级）
# 把下面「请填写」项改成真实值，切勿把 .env 提交到 Git

# ---- 数据库（按你线上实际修改）----
DATABASE_URL=postgresql://用户:密码@127.0.0.1:5432/quizwiz

# ---- JWT（请改为随机长字符串）----
JWT_SECRET=请填写随机长字符串

# ---- 微信小程序 code2Session（AppSecret 在微信公众平台重置后填入）----
WECHAT_MINI_APPID=wxda81343eb7dbf460
WECHAT_MINI_SECRET=请填写小程序 AppSecret

# ---- API 端口（与 Nginx proxy_pass 一致）----
API_PORT=3000

# ---- 可选：上传文件公网前缀 ----
# UPLOAD_PUBLIC_BASE=https://www.quizwiz.cn
