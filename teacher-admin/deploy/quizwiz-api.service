[Unit]
Description=QuizWiz teacher-admin API (Node + Express)
# 将下面所有 /home/ubuntu/QuizWiz 中的 ubuntu 换成你的 SSH 登录用户名；若用独立系统用户再改 User/Group
Documentation=file:///home/ubuntu/QuizWiz/teacher-admin/deploy/DEPLOY.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/QuizWiz/teacher-admin
Environment=NODE_ENV=production
EnvironmentFile=/home/ubuntu/QuizWiz/teacher-admin/.env
ExecStart=/usr/bin/node server/index.js
Restart=on-failure
RestartSec=5
TimeoutStopSec=30

# 大文件导入 / 导出时可适当加大（与 Nginx client_max_body_size 一致）
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
