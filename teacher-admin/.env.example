# 教师端 Node API（复制为 .env 后填写；勿提交含真实密码的 .env）
API_PORT=3000
JWT_SECRET=请改为至少32字节的随机串

# 数据库（二选一）
# DATABASE_URL=postgresql://quizwiz_app:密码@127.0.0.1:5432/quizwiz
PGHOST=127.0.0.1
PGPORT=5432
PGUSER=quizwiz_app
PGPASSWORD=
PGDATABASE=quizwiz

# 对外访问上传文件的根 URL（生产须为 https 站点根，无末尾 /）
# 须与浏览器访问域名一致，否则题目资源 URL 校验会失败
UPLOAD_PUBLIC_BASE=https://www.quizwiz.cn

# 小程序 code2Session（须与 student-front/config/site.js、project.config.json 的 appid 一致）
WECHAT_MINI_APPID=
WECHAT_MINI_SECRET=

# 若教师端与 API 不同域，在此追加允许的 Origin（逗号分隔）
# CORS_EXTRA_ORIGINS=https://admin.example.com

# 仅本地联调小程序 / 任意 Origin 时（勿用于生产）
# QUIZWIZ_DEV_CORS_ANY=1

# 本地 Vite 开发：指向本机 API（见 vite.config.ts）
VITE_API_BASE_URL=http://127.0.0.1:3000
