/* Apple 风格设计变量与全局组件（分组灰底 + 白卡片 + 系统蓝） */
page {
  --ios-bg-grouped: #f2f2f7;
  --ios-fill: #ffffff;
  --ios-label: #000000;
  --ios-secondary: rgba(60, 60, 67, 0.6);
  --ios-tertiary: rgba(60, 60, 67, 0.3);
  --ios-separator: rgba(60, 60, 67, 0.12);
  --ios-tint: #007aff;
  --ios-green: #34c759;
  --ios-red: #ff3b30;
  --ios-radius-card: 24rpx;
  --ios-radius-btn: 20rpx;
  --ios-shadow: 0 4rpx 24rpx rgba(0, 0, 0, 0.06);
  --ui-pill-radius: 100rpx;
  --ui-modal-radius: 22rpx;

  background: var(--ios-bg-grouped);
  color: var(--ios-label);
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Helvetica Neue", "Segoe UI", sans-serif;
  font-size: 28rpx;
  line-height: 1.4;
  letter-spacing: 0.02em;
}

.page-wrap {
  padding: 32rpx 32rpx 200rpx;
  box-sizing: border-box;
}

.muted {
  color: var(--ios-secondary);
}

.h1 {
  font-size: 52rpx;
  font-weight: 700;
  letter-spacing: -0.02em;
  line-height: 1.15;
}

.h2 {
  font-size: 34rpx;
  font-weight: 600;
  letter-spacing: -0.01em;
}

.section-label {
  display: block;
  font-size: 22rpx;
  font-weight: 600;
  color: var(--ios-secondary);
  text-transform: uppercase;
  letter-spacing: 0.08em;
  margin: 32rpx 8rpx 12rpx;
}

.divider-top {
  border-top: 1rpx solid var(--ios-separator);
}

/* 主按钮：iOS 填充蓝（与 ui-* 次要按钮同系圆角与阴影） */
.btn-primary {
  height: 96rpx;
  border-radius: var(--ios-radius-btn);
  background: var(--ios-tint);
  color: #fff;
  font-size: 32rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 6rpx 22rpx rgba(0, 122, 255, 0.26);
}

.btn-primary:active {
  opacity: 0.88;
}

.btn-primary.disabled {
  background: var(--ios-tertiary);
  color: rgba(255, 255, 255, 0.85);
  box-shadow: none;
}

/* 分组白卡片 */
.ios-card {
  background: var(--ios-fill);
  border-radius: var(--ios-radius-card);
  overflow: hidden;
  box-shadow: var(--ios-shadow);
  margin-bottom: 24rpx;
}

.ios-card:last-child {
  margin-bottom: 0;
}

.ios-cell {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 30rpx 28rpx;
  min-height: 96rpx;
  box-sizing: border-box;
}

.ios-cell:active {
  background: rgba(0, 0, 0, 0.04);
}

.ios-cell + .ios-cell {
  border-top: 1rpx solid var(--ios-separator);
}

.ios-cell-main {
  flex: 1;
  min-width: 0;
}

.ios-cell-title {
  font-size: 32rpx;
  font-weight: 500;
  color: var(--ios-label);
}

.ios-cell-sub {
  margin-top: 6rpx;
  font-size: 24rpx;
  color: var(--ios-secondary);
  display: block;
}

.ios-cell-chevron {
  color: var(--ios-tertiary);
  font-size: 36rpx;
  font-weight: 300;
  margin-left: 20rpx;
  line-height: 1;
}

.ios-check {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--ios-tint);
  margin-left: 16rpx;
}

/* 兼容旧 class：列表行映射到卡片内样式（无卡片容器时单条也成立） */
.cell {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 30rpx 28rpx;
  background: var(--ios-fill);
  border-radius: var(--ios-radius-card);
  margin-bottom: 16rpx;
  box-shadow: var(--ios-shadow);
}

.cell-main {
  flex: 1;
  min-width: 0;
}

.cell-title {
  font-size: 32rpx;
  font-weight: 500;
}

.cell-sub {
  margin-top: 8rpx;
  font-size: 24rpx;
  display: block;
  color: var(--ios-secondary);
}

.cell-arrow {
  color: var(--ios-tertiary);
  font-size: 36rpx;
  margin-left: 20rpx;
}

/* 文字链接 */
.link-tint {
  color: var(--ios-tint);
  font-size: 28rpx;
  font-weight: 500;
}

.link-tint:active {
  opacity: 0.65;
}

/* 页面主标题区：左色条 + 眉标 + 主标题 + 副文案（首页 / 刷题 / 学习 / 记录页共用） */
.page-hero {
  display: flex;
  flex-direction: row;
  align-items: stretch;
  margin: 0 0 28rpx;
  padding: 4rpx 8rpx 0 4rpx;
  box-sizing: border-box;
}

.page-hero--compact {
  margin-bottom: 20rpx;
  padding-top: 0;
}

.page-hero-accent {
  width: 10rpx;
  border-radius: 10rpx;
  background: linear-gradient(165deg, #0a84ff 0%, #007aff 42%, #5e5ce6 100%);
  margin-right: 24rpx;
  flex-shrink: 0;
  box-shadow: 0 4rpx 14rpx rgba(0, 122, 255, 0.2);
}

.page-hero-body {
  flex: 1;
  min-width: 0;
  padding-top: 2rpx;
}

.page-hero-eyebrow {
  display: block;
  font-size: 22rpx;
  font-weight: 700;
  color: var(--ios-tint);
  letter-spacing: 0.12em;
  line-height: 1.25;
  margin-bottom: 12rpx;
}

.page-hero-date {
  display: block;
  font-size: 26rpx;
  font-weight: 600;
  color: var(--ios-secondary);
  letter-spacing: 0.02em;
  margin-bottom: 8rpx;
}

.page-hero-title {
  display: block;
  font-size: 42rpx;
  font-weight: 700;
  letter-spacing: -0.04em;
  line-height: 1.22;
  color: var(--ios-label);
}

.page-hero-title--unit {
  font-size: 36rpx;
  font-weight: 700;
  letter-spacing: -0.03em;
  line-height: 1.34;
  word-break: break-word;
}

.page-hero-lead {
  display: block;
  margin-top: 12rpx;
  font-size: 26rpx;
  line-height: 1.5;
  color: var(--ios-secondary);
}

.page-hero-meta {
  display: block;
  margin-top: 10rpx;
  font-size: 26rpx;
  line-height: 1.4;
  color: var(--ios-secondary);
}

/* 刷题 / 已做题 / 错题本 · 目录态：入口名大标题，「选择科目与单元」为副线提示 */
.page-hero--catalog-root .page-hero-title {
  font-size: 48rpx;
  font-weight: 700;
  letter-spacing: -0.05em;
  line-height: 1.12;
  color: var(--ios-label);
}

.page-hero--catalog-root .page-hero-lead {
  margin-top: 10rpx;
  font-size: 26rpx;
  line-height: 1.45;
}

/* —— 内页返回：‹ +「返回上一级」—— */
.nav-row {
  margin-bottom: 20rpx;
}

.nav-back-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  margin-left: -8rpx;
  padding: 4rpx 0;
}

.nav-back-row:active {
  opacity: 0.55;
}

.nav-back {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-width: 48rpx;
  min-height: 64rpx;
  margin-left: 0;
  font-size: 52rpx;
  font-weight: 300;
  line-height: 1;
  color: var(--ios-tint);
  padding: 8rpx 4rpx 8rpx 8rpx;
  box-sizing: border-box;
}

.nav-back-hint {
  font-size: 28rpx;
  font-weight: 500;
  color: var(--ios-tint);
  padding: 8rpx 12rpx 8rpx 0;
  line-height: 1.3;
}

/* —— 做题顶栏：重选 / 跳转 / 题号 / 练习·考试 —— */
.ui-toolbar {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
  margin-bottom: 20rpx;
  padding: 12rpx 14rpx 12rpx 16rpx;
  box-sizing: border-box;
  background: var(--ios-fill);
  border-radius: var(--ios-radius-card);
  box-shadow: var(--ios-shadow);
  border: 1rpx solid rgba(60, 60, 67, 0.08);
}

.ui-toolbar-mid {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
}

.ui-stat {
  font-size: 28rpx;
  font-weight: 700;
  letter-spacing: -0.02em;
  color: var(--ios-label);
}

.ui-chip {
  flex-shrink: 0;
  padding: 14rpx 22rpx;
  font-size: 26rpx;
  font-weight: 600;
  line-height: 1.2;
  border-radius: var(--ui-pill-radius);
  max-width: 38%;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  box-sizing: border-box;
}

.ui-chip:active {
  opacity: 0.86;
}

.ui-chip--tint {
  background: rgba(0, 122, 255, 0.12);
  color: var(--ios-tint);
}

.ui-chip--neutral {
  background: rgba(60, 60, 67, 0.08);
  color: var(--ios-label);
}

.ui-mode {
  flex-shrink: 0;
  padding: 10rpx 18rpx;
  font-size: 22rpx;
  font-weight: 700;
  letter-spacing: 0.08em;
  border-radius: var(--ui-pill-radius);
}

.ui-mode--practice {
  background: rgba(0, 122, 255, 0.14);
  color: var(--ios-tint);
}

.ui-mode--exam {
  background: rgba(255, 149, 0, 0.22);
  color: #b45309;
}

/* —— 说明 / 提示条（替代零散 style-tip） —— */
.ui-callout {
  display: block;
  margin: 0 0 20rpx;
  padding: 18rpx 22rpx;
  font-size: 24rpx;
  line-height: 1.5;
  color: var(--ios-secondary);
  background: rgba(255, 255, 255, 0.92);
  border-radius: 16rpx;
  border: 1rpx solid var(--ios-separator);
  border-left: 6rpx solid var(--ios-tint);
  box-sizing: border-box;
}

.ui-callout--center {
  text-align: center;
  border-left-width: 1rpx;
  padding-top: 14rpx;
  padding-bottom: 14rpx;
  margin-bottom: 16rpx;
  font-size: 22rpx;
}

/* —— 与主按钮同高的线框次要按钮（上一题等） —— */
.ui-btn-secondary {
  flex-shrink: 0;
  min-width: 172rpx;
  height: 96rpx;
  padding: 0 24rpx;
  box-sizing: border-box;
  border-radius: var(--ios-radius-btn);
  border: 2rpx solid var(--ios-separator);
  background: var(--ios-fill);
  color: var(--ios-label);
  font-size: 30rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.04);
}

.ui-btn-secondary:active {
  background: rgba(60, 60, 67, 0.05);
}

/* —— 底栏小按钮（上一页图标 / 立即刷题） —— */
.ui-row-btn {
  height: 72rpx;
  padding: 0 32rpx;
  box-sizing: border-box;
  border-radius: 16rpx;
  font-size: 28rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
}

.ui-row-btn--icon {
  width: 72rpx;
  min-width: 72rpx;
  padding: 0;
  font-size: 48rpx;
  font-weight: 300;
  line-height: 1;
}

.ui-row-btn--ghost {
  border: 2rpx solid var(--ios-separator);
  background: var(--ios-fill);
  color: var(--ios-label);
}

.ui-row-btn--ghost.ui-row-btn--icon {
  color: var(--ios-tint);
  border-color: rgba(0, 122, 255, 0.28);
}

/* 底栏：‹ +「返回上一级」 */
.ui-row-btn--ghost.ui-row-btn--back {
  min-width: auto;
  padding: 0 22rpx;
  gap: 6rpx;
  color: var(--ios-tint);
  border-color: rgba(0, 122, 255, 0.28);
  font-weight: 600;
}

.ui-row-btn-chevron {
  font-size: 40rpx;
  font-weight: 300;
  line-height: 1;
}

.ui-row-btn--ghost:active {
  background: rgba(60, 60, 67, 0.05);
}

.ui-row-btn--primary {
  background: var(--ios-tint);
  color: #fff;
  box-shadow: 0 4rpx 16rpx rgba(0, 122, 255, 0.22);
}

.ui-row-btn--primary:active {
  opacity: 0.92;
}

/* —— 弹层底部双按钮 —— */
.ui-modal-actions {
  display: flex;
  flex-direction: row;
  gap: 16rpx;
  margin-top: 28rpx;
}

.ui-modal-btn {
  flex: 1;
  height: 88rpx;
  border-radius: var(--ui-modal-radius);
  font-size: 30rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}

.ui-modal-btn--cancel {
  background: rgba(60, 60, 67, 0.08);
  color: var(--ios-label);
}

.ui-modal-btn--ok {
  background: var(--ios-tint);
  color: #fff;
}

.ui-modal-btn--cancel:active,
.ui-modal-btn--ok:active {
  opacity: 0.9;
}

/* —— 列表顶条带操作（一起练） —— */
.ui-strip-btn {
  text-align: center;
  padding: 24rpx 28rpx;
  border-radius: var(--ios-radius-btn);
  font-size: 28rpx;
  font-weight: 600;
  color: var(--ios-tint);
  background: rgba(0, 122, 255, 0.1);
  border: 1rpx solid rgba(0, 122, 255, 0.22);
  box-sizing: border-box;
}

.ui-strip-btn:active {
  opacity: 0.9;
}

/* —— 列表行内文字按钮（再练 / 移出） —— */
.ui-link-btn {
  font-size: 26rpx;
  font-weight: 600;
  padding: 14rpx 24rpx;
  border-radius: var(--ui-pill-radius);
  line-height: 1.2;
}

.ui-link-btn--muted {
  color: var(--ios-secondary);
  background: rgba(60, 60, 67, 0.08);
}

.ui-link-btn--tint {
  color: var(--ios-tint);
  background: rgba(0, 122, 255, 0.12);
}

.ui-link-btn:active {
  opacity: 0.88;
}
