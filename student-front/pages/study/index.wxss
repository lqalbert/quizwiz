.study-page {
  padding-top: 8rpx;
  padding-bottom: 48rpx;
}

.study-hero {
  margin-bottom: 24rpx;
}

.class-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 28rpx;
  margin-bottom: 16rpx;
  gap: 20rpx;
}

.class-bar-label {
  font-size: 26rpx;
  flex-shrink: 0;
}

.class-picker-trigger {
  display: flex;
  align-items: center;
  gap: 8rpx;
  max-width: 70%;
}

.class-picker-text {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--ios-label);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.class-picker-text.single {
  flex: 1;
  text-align: right;
}

.class-picker-chev {
  font-size: 32rpx;
  color: var(--ios-secondary);
}

.pad-card {
  padding: 32rpx 28rpx;
}

.wf-wrap {
  display: flex;
  flex-direction: row;
  align-items: flex-start;
  gap: 16rpx;
  margin-bottom: 28rpx;
}

.wf-col {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.wf-card {
  background: #fff;
  border-radius: 20rpx;
  padding: 20rpx 20rpx 16rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.06);
}

.wf-card-type {
  display: inline-block;
  font-size: 20rpx;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  background: rgba(0, 122, 255, 0.12);
  color: #007aff;
  margin-bottom: 12rpx;
}

.wf-card-name {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: var(--ios-label);
  line-height: 1.4;
  word-break: break-all;
}

.wf-card-actions {
  margin-top: 16rpx;
  display: flex;
  justify-content: flex-end;
}

.wf-btn {
  font-size: 24rpx;
  color: #007aff;
  padding: 8rpx 16rpx;
}

.video-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 1000;
  background: rgba(0, 0, 0, 0.55);
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 40rpx;
  box-sizing: border-box;
}

.video-dialog {
  width: 100%;
  max-width: 680rpx;
  background: #000;
  border-radius: 16rpx;
  overflow: hidden;
}

.video-player {
  width: 100%;
  height: 400rpx;
  display: block;
}

.video-close {
  text-align: center;
  padding: 20rpx;
  font-size: 28rpx;
  color: #fff;
  background: rgba(255, 255, 255, 0.12);
}
