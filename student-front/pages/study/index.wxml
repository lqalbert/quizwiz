<view class="page-wrap">
  <text class="h1 page-title">学习</text>
  <text class="lead muted">选一个专题开始</text>

  <view class="list-block divider-top">
    <block wx:for="{{items}}" wx:key="id">
      <view class="cell" bindtap="openItem" data-id="{{item.id}}">
        <view class="cell-main">
          <text class="cell-title">{{item.title}}</text>
          <text class="cell-sub muted">{{item.sub}}</text>
        </view>
        <text class="cell-arrow">›</text>
      </view>
    </block>
  </view>
</view>
