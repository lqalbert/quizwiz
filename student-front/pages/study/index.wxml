<view class="page-wrap study-page">
  <view class="step-head">
    <text class="page-hero">学习</text>
    <text class="page-lead muted">选一个专题开始</text>
  </view>

  <view class="ios-card">
    <block wx:for="{{items}}" wx:key="id">
      <view class="ios-cell" bindtap="openItem" data-id="{{item.id}}">
        <view class="ios-cell-main">
          <text class="ios-cell-title">{{item.title}}</text>
          <text class="ios-cell-sub">{{item.sub}}</text>
        </view>
        <text class="ios-cell-chevron">›</text>
      </view>
    </block>
  </view>
</view>
