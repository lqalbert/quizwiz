<view class="page-wrap study-page">
  <view class="page-hero study-hero">
    <view class="page-hero-accent"></view>
    <view class="page-hero-body">
      <text class="page-hero-eyebrow">学习</text>
      <text class="page-hero-title">专题目录</text>
      <text class="page-hero-lead muted">选一个专题，巩固对应知识</text>
    </view>
  </view>
  <view class="ios-card">
    <block wx:for="{{items}}" wx:key="id">
      <view class="ios-cell" bindtap="openItem" data-id="{{item.id}}">
        <view class="ios-cell-main">
          <text class="ios-cell-title">{{item.title}}</text>
          <text class="ios-cell-sub">{{item.sub}}</text>
        </view>
        <text class="ios-cell-chevron">›</text>
      </view>
    </block>
  </view>
</view>
