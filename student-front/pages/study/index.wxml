<view class="page-wrap study-page">
  <view class="page-hero page-hero--motto study-hero">
    <image class="motto-banner-bg" src="/assets/motto/motto-study.jpg" mode="aspectFill" />
    <view class="motto-card-inner">
      <text class="motto-main">勤能补拙</text>
      <text class="motto-sub">学可医愚</text>
    </view>
  </view>

  <view wx:if="{{loggedIn && classes === null}}" class="ios-card pad-card">
    <text class="muted">加载中…</text>
  </view>

  <view wx:elif="{{loggedIn && classes.length === 0}}" class="ios-card pad-card">
    <text class="muted">未加入班级暂无数据</text>
    <text class="muted study-guest-desc">请登录后在「我的 → 加入班级」填写真实姓名与邀请码</text>
  </view>

  <block wx:elif="{{loggedIn || isGuestBrowse}}">
    <view wx:if="{{loggedIn}}" class="class-bar ios-card">
      <text class="class-bar-label muted">当前班级</text>
      <picker wx:if="{{classes.length > 1}}" mode="selector" range="{{classes}}" range-key="label" value="{{classIndex}}" bindchange="onClassPick">
        <view class="class-picker-trigger">
          <text class="class-picker-text">{{currentClassLabel}}</text>
          <text class="class-picker-chev">›</text>
        </view>
      </picker>
      <text wx:else class="class-picker-text single">{{currentClassLabel}}</text>
    </view>
    <view wx:else class="class-bar ios-card">
      <text class="class-bar-label muted">当前范围</text>
      <text class="class-picker-text single">{{currentClassLabel}}</text>
    </view>

    <view wx:if="{{resourcesLoading}}" class="ios-card pad-card">
      <text class="muted">正在加载资料…</text>
    </view>

    <view wx:elif="{{resourcesEmpty}}" class="ios-card pad-card">
      <text class="muted">{{loggedIn ? '暂无可见资料（教师可能尚未上传，或资料未对本班开放）' : '暂无公开资料'}}</text>
    </view>

    <block wx:else>
    <block wx:for="{{sections}}" wx:key="subject_key">
      <text class="section-label">{{item.subject_name}}</text>
      <view class="wf-wrap">
        <view class="wf-col">
          <block wx:for="{{item.left}}" wx:key="id" wx:for-item="card">
            <view
              class="wf-card"
              hover-class="wf-card-hover"
              hover-stay-time="70"
              bindtap="onTapCard"
              data-id="{{card.id}}"
              data-ft="{{card.file_type}}"
              data-url="{{card.file_url_abs}}"
              data-turbo="{{card.turbo_download_url}}"
              data-name="{{card.name}}"
              data-candl="{{card.can_dl ? '1' : '0'}}"
            >
              <view class="wf-card-type-row">
                <view class="wf-card-type">{{card.file_type}}</view>
                <text wx:if="{{card.local_saved}}" class="wf-card-saved">已下载</text>
              </view>
              <text class="wf-card-name">{{card.name}}</text>
              <view class="wf-card-actions">
                <view
                  class="wf-btn"
                  hover-class="wf-btn-hover"
                  hover-stay-time="70"
                  data-id="{{card.id}}"
                  data-name="{{card.name}}"
                  data-url="{{card.file_url_abs}}"
                  data-turbo="{{card.turbo_download_url}}"
                  data-ft="{{card.file_type}}"
                  data-local="{{card.local_saved ? '1' : '0'}}"
                  data-candl="{{card.can_dl ? '1' : '0'}}"
                  catchtap="onTapDownload"
                >
                  {{card.local_saved ? '打开' : '下载'}}
                </view>
              </view>
            </view>
          </block>
        </view>
        <view class="wf-col">
          <block wx:for="{{item.right}}" wx:key="id" wx:for-item="card">
            <view
              class="wf-card"
              hover-class="wf-card-hover"
              hover-stay-time="70"
              bindtap="onTapCard"
              data-id="{{card.id}}"
              data-ft="{{card.file_type}}"
              data-url="{{card.file_url_abs}}"
              data-turbo="{{card.turbo_download_url}}"
              data-name="{{card.name}}"
              data-candl="{{card.can_dl ? '1' : '0'}}"
            >
              <view class="wf-card-type-row">
                <view class="wf-card-type">{{card.file_type}}</view>
                <text wx:if="{{card.local_saved}}" class="wf-card-saved">已下载</text>
              </view>
              <text class="wf-card-name">{{card.name}}</text>
              <view class="wf-card-actions">
                <view
                  class="wf-btn"
                  hover-class="wf-btn-hover"
                  hover-stay-time="70"
                  data-id="{{card.id}}"
                  data-name="{{card.name}}"
                  data-url="{{card.file_url_abs}}"
                  data-turbo="{{card.turbo_download_url}}"
                  data-ft="{{card.file_type}}"
                  data-local="{{card.local_saved ? '1' : '0'}}"
                  data-candl="{{card.can_dl ? '1' : '0'}}"
                  catchtap="onTapDownload"
                >
                  {{card.local_saved ? '打开' : '下载'}}
                </view>
              </view>
            </view>
          </block>
        </view>
      </view>
    </block>
    </block>
  </block>

  <view wx:if="{{videoPreviewVisible}}" class="video-mask" catchtouchmove="noop" bindtap="closeVideoPreview">
    <view class="video-dialog" catchtap="noop">
      <video class="video-player" src="{{videoPreviewUrl}}" controls></video>
      <view class="video-close" hover-class="video-close-hover" hover-stay-time="70" bindtap="closeVideoPreview">关闭</view>
    </view>
  </view>

  <view wx:if="{{audioPreviewVisible}}" class="audio-sheet" catchtouchmove="noop">
    <view class="audio-sheet-inner" catchtap="noop">
      <text class="audio-sheet-title">{{audioPreviewName}}</text>
      <view class="audio-sheet-row">
        <view class="audio-sheet-btn" hover-class="audio-sheet-btn-hover" hover-stay-time="70" bindtap="toggleAudioPreview">{{audioPlaying ? '暂停' : '播放'}}</view>
        <view class="audio-sheet-btn audio-sheet-btn-muted" hover-class="audio-sheet-btn-hover" hover-stay-time="70" bindtap="closeAudioPreview">关闭</view>
      </view>
    </view>
  </view>
</view>
