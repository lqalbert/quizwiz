.quiz-root {
  padding-bottom: 200rpx;
}

.loading-pill {
  display: inline-block;
  padding: 16rpx 28rpx;
  background: rgba(60, 60, 67, 0.08);
  border-radius: 100rpx;
  font-size: 26rpx;
}

.step-head {
  margin-bottom: 24rpx;
}

.step-title {
  display: block;
  font-size: 52rpx;
  font-weight: 700;
  letter-spacing: -0.03em;
  line-height: 1.12;
}

.step-caption {
  display: block;
  margin-top: 12rpx;
  font-size: 28rpx;
  line-height: 1.4;
}

.mt {
  margin-top: 36rpx;
}

.mock-scroll {
  max-height: 52vh;
  margin-top: 8rpx;
  padding-bottom: 8rpx;
  box-sizing: border-box;
}

.mock-card {
  background: #fff;
  border-radius: var(--ios-radius-card);
  padding: 28rpx 28rpx 32rpx;
  margin-bottom: 24rpx;
  box-shadow: var(--ios-shadow);
  border: 1rpx solid rgba(60, 60, 67, 0.06);
  box-sizing: border-box;
}

.mock-card-title {
  display: block;
  font-size: 32rpx;
  font-weight: 700;
  letter-spacing: -0.02em;
  color: #1c1c1e;
  line-height: 1.3;
}

.mock-card-bank {
  display: block;
  margin-top: 12rpx;
  font-size: 24rpx;
  line-height: 1.4;
}

.mock-field {
  margin-top: 24rpx;
}

.mock-field-caption {
  display: block;
  margin-bottom: 12rpx;
  font-size: 24rpx;
  font-weight: 600;
  color: var(--ios-secondary);
}

.mock-field-input {
  width: 100%;
  height: 96rpx;
  padding: 0 24rpx;
  box-sizing: border-box;
  border-radius: 16rpx;
  border: 2rpx solid rgba(0, 122, 255, 0.35);
  background: rgba(0, 122, 255, 0.06);
  font-size: 34rpx;
  font-weight: 600;
  color: var(--ios-label);
}

.mock-field-input-off {
  opacity: 0.45;
  border-color: rgba(60, 60, 67, 0.12);
  background: rgba(60, 60, 67, 0.06);
  color: var(--ios-secondary);
}

.mock-ph {
  color: rgba(60, 60, 67, 0.42);
  font-size: 26rpx;
  font-weight: 400;
}

.play-toolbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
  padding: 0 4rpx;
}

.toolbar-link {
  font-size: 28rpx;
  font-weight: 500;
}

.toolbar-count {
  font-size: 30rpx;
  font-weight: 600;
  letter-spacing: -0.02em;
}

.toolbar-count-plain {
  flex: 1;
  text-align: center;
}

.toolbar-center-seq {
  flex: 1;
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  gap: 20rpx;
  min-width: 0;
}

.toolbar-jump {
  font-size: 28rpx;
  font-weight: 600;
  padding: 8rpx 16rpx;
  border-radius: 12rpx;
  background: rgba(0, 122, 255, 0.12);
}

.seq-toolbar-hint {
  display: block;
  text-align: center;
  font-size: 22rpx;
  margin: 8rpx 0 4rpx;
}

.seq-jump-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.45);
  z-index: 1000;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 48rpx;
  box-sizing: border-box;
}

.seq-jump-card {
  width: 100%;
  max-width: 600rpx;
  background: #fff;
  border-radius: 24rpx;
  padding: 36rpx 32rpx 28rpx;
  box-sizing: border-box;
}

.seq-jump-title {
  display: block;
  font-size: 34rpx;
  font-weight: 700;
  text-align: center;
  color: #1c1c1e;
}

.seq-jump-range {
  display: block;
  margin-top: 12rpx;
  font-size: 24rpx;
  text-align: center;
}

.seq-jump-input {
  margin-top: 28rpx;
  width: 100%;
  height: 88rpx;
  padding: 0 20rpx;
  box-sizing: border-box;
  border-radius: 14rpx;
  border: 2rpx solid rgba(60, 60, 67, 0.18);
  background: rgba(60, 60, 67, 0.05);
  font-size: 32rpx;
  font-weight: 600;
  text-align: center;
}

.seq-jump-actions {
  display: flex;
  flex-direction: row;
  margin-top: 28rpx;
  gap: 20rpx;
}

.seq-jump-btn {
  flex: 1;
  height: 88rpx;
  border-radius: 14rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  font-weight: 600;
}

.seq-jump-btn-cancel {
  background: rgba(60, 60, 67, 0.08);
  color: #1c1c1e;
}

.seq-jump-btn-ok {
  background: var(--ios-tint);
  color: #fff;
}

.toolbar-badge {
  font-size: 22rpx;
  font-weight: 600;
  color: var(--ios-secondary);
  background: rgba(60, 60, 67, 0.08);
  padding: 8rpx 20rpx;
  border-radius: 100rpx;
}

.progress-track {
  height: 6rpx;
  background: rgba(60, 60, 67, 0.12);
  border-radius: 6rpx;
  margin-bottom: 28rpx;
  overflow: hidden;
}

.progress-fill {
  height: 100%;
  background: var(--ios-tint);
  border-radius: 6rpx;
  transition: width 0.2s ease;
}

.play-card {
  padding: 32rpx 28rpx 28rpx;
}

.type-pill {
  display: inline-block;
  font-size: 22rpx;
  font-weight: 600;
  letter-spacing: 0.06em;
  margin-bottom: 16rpx;
}

.stem-text {
  display: block;
  font-size: 32rpx;
  font-weight: 500;
  line-height: 1.5;
  letter-spacing: -0.01em;
  white-space: pre-line;
}

.opt-pill {
  display: flex;
  align-items: flex-start;
  margin-top: 20rpx;
  padding: 28rpx 24rpx;
  border-radius: 16rpx;
  background: rgba(60, 60, 67, 0.06);
  border: 2rpx solid transparent;
  box-sizing: border-box;
}

.opt-pill:active {
  opacity: 0.9;
}

.opt-pill-on {
  background: rgba(0, 122, 255, 0.1);
  border-color: var(--ios-tint);
}

.opt-pill-k {
  width: 44rpx;
  flex-shrink: 0;
  font-size: 28rpx;
  font-weight: 700;
  color: var(--ios-tint);
}

.opt-pill-t {
  flex: 1;
  padding-left: 12rpx;
  font-size: 30rpx;
  line-height: 1.45;
}

.judge-row {
  display: flex;
  gap: 20rpx;
  margin-top: 28rpx;
}

.judge-pill {
  flex: 1;
  text-align: center;
  padding: 28rpx 0;
  border-radius: 16rpx;
  font-size: 32rpx;
  font-weight: 600;
  background: rgba(60, 60, 67, 0.06);
  border: 2rpx solid transparent;
}

.judge-pill-on {
  background: rgba(0, 122, 255, 0.12);
  border-color: var(--ios-tint);
  color: var(--ios-tint);
}

.answer-area {
  margin-top: 24rpx;
  width: 100%;
  min-height: 200rpx;
  padding: 24rpx;
  box-sizing: border-box;
  border-radius: 16rpx;
  background: rgba(60, 60, 67, 0.06);
  font-size: 30rpx;
  line-height: 1.45;
}

.feedback-card {
  margin-top: 24rpx;
  padding: 28rpx;
}

.fb-title {
  display: block;
  font-size: 32rpx;
  font-weight: 700;
}

.fb-ok {
  color: var(--ios-green);
}

.fb-bad {
  color: var(--ios-red);
}

.fb-meta {
  display: block;
  margin-top: 12rpx;
  font-size: 26rpx;
}

.fb-exp {
  display: block;
  margin-top: 16rpx;
  font-size: 28rpx;
  line-height: 1.45;
  color: var(--ios-label);
}

.play-submit.disabled {
  opacity: 1;
}

.play-actions-row {
  display: flex;
  flex-direction: row;
  align-items: stretch;
  gap: 20rpx;
}

.btn-exam-prev {
  flex-shrink: 0;
  min-width: 168rpx;
  height: 96rpx;
  padding: 0 28rpx;
  box-sizing: border-box;
  border-radius: var(--ios-radius-btn);
  border: 2rpx solid rgba(60, 60, 67, 0.22);
  background: #fff;
  color: var(--ios-label);
  font-size: 30rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
}

.btn-exam-prev:active {
  background: rgba(60, 60, 67, 0.06);
}

.play-submit-flex {
  flex: 1;
  min-width: 0;
  margin-top: 0;
}

.result-scroll {
  max-height: 58vh;
  margin-top: 8rpx;
}

.result-item {
  padding: 28rpx;
  margin-bottom: 20rpx;
}

.r-miss {
  font-size: 28rpx;
}

.r-stem {
  font-size: 30rpx;
  line-height: 1.45;
  font-weight: 500;
  white-space: pre-line;
}

.r-flag {
  display: block;
  margin-top: 12rpx;
  font-size: 28rpx;
  font-weight: 700;
}

.r-meta {
  display: block;
  margin-top: 8rpx;
  font-size: 24rpx;
}

.r-exp {
  display: block;
  margin-top: 12rpx;
  font-size: 26rpx;
  line-height: 1.45;
  color: var(--ios-label);
}

/* —— 图1：左栏科目 + 右栏知识单元 —— */
.nav-row {
  margin-bottom: 20rpx;
}

.nav-back {
  font-size: 30rpx;
  font-weight: 500;
  color: var(--ios-tint);
}

.catalog-wrap {
  display: flex;
  flex-direction: row;
  height: calc(100vh - 320rpx);
  min-height: 560rpx;
  background: #fff;
  border-radius: var(--ios-radius-card);
  overflow: hidden;
  box-shadow: var(--ios-shadow);
}

.catalog-left {
  width: 200rpx;
  flex-shrink: 0;
  background: #f2f2f7;
  max-height: 100%;
}

.unit-tab {
  padding: 28rpx 20rpx;
  font-size: 28rpx;
  color: #333;
  border-left: 6rpx solid transparent;
}

.unit-tab-on {
  background: #fff;
  color: #b45309;
  font-weight: 600;
  border-left-color: #c2410c;
}

.catalog-right {
  flex: 1;
  min-width: 0;
  max-height: 100%;
  background: #fff;
}

.point-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 32rpx 28rpx;
  border-bottom: 1rpx solid #eee;
}

.point-row:active {
  background: rgba(0, 0, 0, 0.03);
}

.point-name {
  font-size: 30rpx;
  color: #111;
}

.point-chev {
  color: #ccc;
  font-size: 36rpx;
  font-weight: 300;
}

/* —— 图2：刷题模式四宫格 —— */
.style-head {
  margin-bottom: 28rpx;
}

.style-title {
  display: block;
  font-size: 40rpx;
  font-weight: 700;
  color: #111;
}

.style-count {
  display: block;
  margin-top: 12rpx;
  font-size: 26rpx;
  color: #888;
}

.style-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 24rpx;
  padding: 8rpx 0 24rpx;
}

.style-card {
  background: #fff;
  border-radius: 20rpx;
  padding: 36rpx 24rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.06);
  text-align: center;
  min-height: 220rpx;
  box-sizing: border-box;
}

.style-card:active {
  opacity: 0.92;
}

.style-card-off {
  opacity: 0.45;
}

.style-icon {
  display: block;
  font-size: 48rpx;
  margin-bottom: 16rpx;
  line-height: 1;
}

.style-card-title {
  display: block;
  font-size: 30rpx;
  font-weight: 600;
  color: #111;
}

.style-card-sub {
  display: block;
  margin-top: 12rpx;
  font-size: 22rpx;
  line-height: 1.35;
}

.style-tip {
  display: block;
  font-size: 22rpx;
  line-height: 1.45;
  padding: 0 8rpx 24rpx;
}

.empty-right {
  justify-content: center;
}

.subsection-scroll {
  max-height: calc(100vh - 520rpx);
  min-height: 280rpx;
  margin-bottom: 16rpx;
  padding-bottom: 220rpx;
  box-sizing: border-box;
}

.sub-row {
  display: flex;
  flex-direction: row;
  align-items: flex-start;
  padding: 28rpx 24rpx;
  border-bottom: 1rpx solid #eee;
  background: #fff;
  border-left: 6rpx solid transparent;
  box-sizing: border-box;
}

.sub-row:active {
  background: rgba(0, 0, 0, 0.03);
}

.sub-row-on {
  background: rgba(194, 65, 12, 0.07);
  border-left-color: #c2410c;
}

.sub-row-on:active {
  background: rgba(194, 65, 12, 0.1);
}

.sub-cb {
  width: 36rpx;
  height: 36rpx;
  border-radius: 8rpx;
  border: 2rpx solid #c7c7cc;
  margin-right: 20rpx;
  margin-top: 6rpx;
  flex-shrink: 0;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #fff;
}

.sub-cb-on {
  border-color: #c2410c;
  background: #c2410c;
}

.sub-cb-mark {
  font-size: 22rpx;
  font-weight: 700;
  color: #fff;
  line-height: 1;
}

.sub-main {
  flex: 1;
  min-width: 0;
}

.sub-title {
  display: block;
  font-size: 30rpx;
  font-weight: 600;
  color: #111;
}

.sub-progress {
  display: block;
  margin-top: 10rpx;
  font-size: 24rpx;
}

.sub-footer {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 20rpx 28rpx calc(20rpx + env(safe-area-inset-bottom));
  background: rgba(255, 255, 255, 0.96);
  border-top: 1rpx solid #eee;
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  z-index: 20;
}

.sub-footer-left {
  flex: 1;
  min-width: 0;
  padding-right: 16rpx;
}

.sub-footer-title {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
}

.sub-footer-sub {
  display: block;
  margin-top: 6rpx;
  font-size: 22rpx;
}

.sub-footer-btns {
  display: flex;
  flex-direction: row;
  gap: 16rpx;
  flex-shrink: 0;
}

.btn-outline {
  padding: 18rpx 28rpx;
  font-size: 28rpx;
  font-weight: 500;
  border-radius: 12rpx;
  border: 2rpx solid #111;
  color: #111;
  background: #fff;
}

.btn-solid {
  padding: 18rpx 28rpx;
  font-size: 28rpx;
  font-weight: 600;
  border-radius: 12rpx;
  background: #111;
  color: #fff;
}
