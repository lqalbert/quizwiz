.quiz-root {
  padding-bottom: 200rpx;
}

.loading-pill {
  display: inline-block;
  padding: 16rpx 28rpx;
  background: rgba(60, 60, 67, 0.08);
  border-radius: 100rpx;
  font-size: 26rpx;
}

.step-head {
  margin-bottom: 24rpx;
}

.step-title {
  display: block;
  font-size: 52rpx;
  font-weight: 700;
  letter-spacing: -0.03em;
  line-height: 1.12;
}

.step-caption {
  display: block;
  margin-top: 12rpx;
  font-size: 28rpx;
  line-height: 1.4;
}

.mt {
  margin-top: 36rpx;
}

.mock-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 28rpx;
  min-height: 96rpx;
  box-sizing: border-box;
}

.mock-row + .mock-row {
  border-top: 1rpx solid var(--ios-separator);
}

.mock-name {
  flex: 1;
  font-size: 30rpx;
  font-weight: 500;
  padding-right: 24rpx;
}

.mock-input {
  width: 140rpx;
  text-align: right;
  font-size: 32rpx;
  font-weight: 600;
  color: var(--ios-tint);
}

.play-toolbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
  padding: 0 4rpx;
}

.toolbar-link {
  font-size: 28rpx;
  font-weight: 500;
}

.toolbar-count {
  font-size: 30rpx;
  font-weight: 600;
  letter-spacing: -0.02em;
}

.toolbar-badge {
  font-size: 22rpx;
  font-weight: 600;
  color: var(--ios-secondary);
  background: rgba(60, 60, 67, 0.08);
  padding: 8rpx 20rpx;
  border-radius: 100rpx;
}

.progress-track {
  height: 6rpx;
  background: rgba(60, 60, 67, 0.12);
  border-radius: 6rpx;
  margin-bottom: 28rpx;
  overflow: hidden;
}

.progress-fill {
  height: 100%;
  background: var(--ios-tint);
  border-radius: 6rpx;
  transition: width 0.2s ease;
}

.play-card {
  padding: 32rpx 28rpx 28rpx;
}

.type-pill {
  display: inline-block;
  font-size: 22rpx;
  font-weight: 600;
  letter-spacing: 0.06em;
  margin-bottom: 16rpx;
}

.stem-text {
  display: block;
  font-size: 32rpx;
  font-weight: 500;
  line-height: 1.5;
  letter-spacing: -0.01em;
}

.opt-pill {
  display: flex;
  align-items: flex-start;
  margin-top: 20rpx;
  padding: 28rpx 24rpx;
  border-radius: 16rpx;
  background: rgba(60, 60, 67, 0.06);
  border: 2rpx solid transparent;
  box-sizing: border-box;
}

.opt-pill:active {
  opacity: 0.9;
}

.opt-pill-on {
  background: rgba(0, 122, 255, 0.1);
  border-color: var(--ios-tint);
}

.opt-pill-k {
  width: 44rpx;
  flex-shrink: 0;
  font-size: 28rpx;
  font-weight: 700;
  color: var(--ios-tint);
}

.opt-pill-t {
  flex: 1;
  padding-left: 12rpx;
  font-size: 30rpx;
  line-height: 1.45;
}

.judge-row {
  display: flex;
  gap: 20rpx;
  margin-top: 28rpx;
}

.judge-pill {
  flex: 1;
  text-align: center;
  padding: 28rpx 0;
  border-radius: 16rpx;
  font-size: 32rpx;
  font-weight: 600;
  background: rgba(60, 60, 67, 0.06);
  border: 2rpx solid transparent;
}

.judge-pill-on {
  background: rgba(0, 122, 255, 0.12);
  border-color: var(--ios-tint);
  color: var(--ios-tint);
}

.answer-area {
  margin-top: 24rpx;
  width: 100%;
  min-height: 200rpx;
  padding: 24rpx;
  box-sizing: border-box;
  border-radius: 16rpx;
  background: rgba(60, 60, 67, 0.06);
  font-size: 30rpx;
  line-height: 1.45;
}

.feedback-card {
  margin-top: 24rpx;
  padding: 28rpx;
}

.fb-title {
  display: block;
  font-size: 32rpx;
  font-weight: 700;
}

.fb-ok {
  color: var(--ios-green);
}

.fb-bad {
  color: var(--ios-red);
}

.fb-meta {
  display: block;
  margin-top: 12rpx;
  font-size: 26rpx;
}

.fb-exp {
  display: block;
  margin-top: 16rpx;
  font-size: 28rpx;
  line-height: 1.45;
  color: var(--ios-label);
}

.play-submit.disabled {
  opacity: 1;
}

.result-scroll {
  max-height: 58vh;
  margin-top: 8rpx;
}

.result-item {
  padding: 28rpx;
  margin-bottom: 20rpx;
}

.r-miss {
  font-size: 28rpx;
}

.r-stem {
  font-size: 30rpx;
  line-height: 1.45;
  font-weight: 500;
}

.r-flag {
  display: block;
  margin-top: 12rpx;
  font-size: 28rpx;
  font-weight: 700;
}

.r-meta {
  display: block;
  margin-top: 8rpx;
  font-size: 24rpx;
}

.r-exp {
  display: block;
  margin-top: 12rpx;
  font-size: 26rpx;
  line-height: 1.45;
  color: var(--ios-label);
}
