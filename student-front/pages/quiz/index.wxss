/* 刷题 tab：顶留白与其它 Tab 一致；底边为 0（Tab 栏已占安全区），左右沿用全局 32rpx */
.page-wrap.quiz-root {
  padding-top: 8rpx;
  padding-bottom: 0;
  box-sizing: border-box;
}

.quiz-root .nav-row {
  margin-bottom: 12rpx;
}

.quiz-root .catalog-hero,
.quiz-root .page-hero--motto {
  margin-bottom: 24rpx;
}

.quiz-root .page-hero--compact {
  margin-bottom: 12rpx;
}

.quiz-root .ui-toolbar {
  margin-bottom: 14rpx;
}

.loading-pill {
  display: inline-block;
  padding: 16rpx 28rpx;
  background: rgba(60, 60, 67, 0.08);
  border-radius: 100rpx;
  font-size: 26rpx;
}

.mt {
  margin-top: 36rpx;
}

/* 模拟分配题数 / 知识小节：flex 定高 + scroll-view height:0，否则无法纵向滑动 */
.mock-step,
.quiz-substep {
  display: flex;
  flex-direction: column;
  height: calc(100vh - 88rpx - env(safe-area-inset-top));
  max-height: calc(100vh - 88rpx - env(safe-area-inset-top));
  overflow: hidden;
  box-sizing: border-box;
}

.mock-scroll,
.subsection-scroll {
  flex: 1;
  height: 0;
  min-height: 0;
  width: 100%;
  margin-top: 8rpx;
  box-sizing: border-box;
}

.mock-scroll-inner {
  /* 底部固定「下一步」栏占位，避免最后一卡被挡住 */
  padding-bottom: calc(160rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.subsection-scroll {
  padding-bottom: calc(200rpx + env(safe-area-inset-bottom));
}

.mock-footer {
  position: fixed;
  left: 0;
  right: 0;
  bottom: calc(100rpx + env(safe-area-inset-bottom));
  padding: 20rpx 28rpx 20rpx;
  background: rgba(255, 255, 255, 0.96);
  border-top: 1rpx solid var(--ios-separator, rgba(60, 60, 67, 0.12));
  z-index: 20;
  box-sizing: border-box;
  box-shadow: 0 -4rpx 24rpx rgba(0, 0, 0, 0.06);
}

.mock-footer-btn {
  margin-top: 0;
  width: 100%;
  box-sizing: border-box;
  text-align: center;
}

.catalog-boot-hint {
  display: block;
  padding: 16rpx 8rpx 8rpx;
  font-size: 26rpx;
}

.catalog-err,
.catalog-empty {
  padding: 28rpx;
  margin-bottom: 16rpx;
}

.catalog-empty-title {
  display: block;
  font-size: 30rpx;
  font-weight: 600;
  margin-bottom: 10rpx;
}

.catalog-empty-desc {
  display: block;
  font-size: 26rpx;
  line-height: 1.45;
}

.catalog-foot {
  display: block;
  font-size: 24rpx;
  margin-top: 12rpx;
  margin-bottom: 8rpx;
}

.play-load-err {
  padding: 28rpx;
  margin-top: 16rpx;
}

.wrapup-card {
  padding: 32rpx 28rpx;
  margin-top: 8rpx;
}

.wrapup-line {
  display: block;
  font-size: 30rpx;
  line-height: 1.5;
}

.wrapup-num {
  font-weight: 700;
}

.wrapup-num--ok {
  color: var(--ios-green);
}

.wrapup-num--bad {
  color: #c2410c;
}

.wrapup-tip {
  display: block;
  margin-top: 16rpx;
  font-size: 26rpx;
  line-height: 1.45;
}

.mock-card {
  background: #fff;
  border-radius: var(--ios-radius-card);
  padding: 28rpx 28rpx 32rpx;
  margin-bottom: 24rpx;
  box-shadow: var(--ios-shadow);
  border: 1rpx solid rgba(60, 60, 67, 0.06);
  box-sizing: border-box;
}

.mock-card-title {
  display: block;
  font-size: 32rpx;
  font-weight: 700;
  letter-spacing: -0.02em;
  color: #1c1c1e;
  line-height: 1.3;
}

.mock-card-bank {
  display: block;
  margin-top: 12rpx;
  font-size: 24rpx;
  line-height: 1.4;
}

.mock-field {
  margin-top: 24rpx;
}

.mock-field-caption {
  display: block;
  margin-bottom: 12rpx;
  font-size: 24rpx;
  font-weight: 600;
  color: var(--ios-secondary);
}

.mock-field-input {
  width: 100%;
  height: 96rpx;
  padding: 0 24rpx;
  box-sizing: border-box;
  border-radius: 16rpx;
  border: 2rpx solid rgba(0, 122, 255, 0.35);
  background: rgba(0, 122, 255, 0.06);
  font-size: 34rpx;
  font-weight: 600;
  color: var(--ios-label);
}

.mock-field-input-off {
  opacity: 0.45;
  border-color: rgba(60, 60, 67, 0.12);
  background: rgba(60, 60, 67, 0.06);
  color: var(--ios-secondary);
}

.mock-ph {
  color: rgba(60, 60, 67, 0.42);
  font-size: 26rpx;
  font-weight: 400;
}

.seq-jump-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.45);
  z-index: 1000;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 48rpx;
  box-sizing: border-box;
}

.seq-jump-card {
  width: 100%;
  max-width: 600rpx;
  background: #fff;
  border-radius: var(--ios-radius-card);
  padding: 36rpx 32rpx 28rpx;
  box-sizing: border-box;
  box-shadow: 0 16rpx 48rpx rgba(0, 0, 0, 0.12);
}

.seq-jump-title {
  display: block;
  font-size: 34rpx;
  font-weight: 700;
  text-align: center;
  color: #1c1c1e;
}

.seq-jump-range {
  display: block;
  margin-top: 12rpx;
  font-size: 24rpx;
  text-align: center;
}

.seq-jump-input {
  margin-top: 28rpx;
  width: 100%;
  height: 88rpx;
  padding: 0 20rpx;
  box-sizing: border-box;
  border-radius: var(--ui-modal-radius);
  border: 2rpx solid var(--ios-separator);
  background: rgba(60, 60, 67, 0.05);
  font-size: 32rpx;
  font-weight: 600;
  text-align: center;
}

.progress-track {
  height: 6rpx;
  background: rgba(60, 60, 67, 0.12);
  border-radius: 6rpx;
  margin-bottom: 28rpx;
  overflow: hidden;
}

.progress-fill {
  height: 100%;
  background: var(--ios-tint);
  border-radius: 6rpx;
  transition: width 0.2s ease;
}

.play-card {
  padding: 32rpx 28rpx 28rpx;
}

.type-pill {
  display: inline-block;
  font-size: 22rpx;
  font-weight: 600;
  letter-spacing: 0.06em;
  margin-bottom: 16rpx;
}

.stem-text {
  display: block;
  font-size: 32rpx;
  font-weight: 500;
  line-height: 1.5;
  letter-spacing: -0.01em;
  white-space: pre-line;
}

.opt-pill {
  display: flex;
  align-items: flex-start;
  margin-top: 20rpx;
  padding: 28rpx 24rpx;
  border-radius: 16rpx;
  background: rgba(60, 60, 67, 0.06);
  border: 2rpx solid transparent;
  box-sizing: border-box;
}

.opt-pill-hover {
  opacity: 0.9;
}

.opt-pill-on {
  background: rgba(0, 122, 255, 0.1);
  border-color: var(--ios-tint);
}

.opt-pill-k {
  width: 44rpx;
  flex-shrink: 0;
  font-size: 28rpx;
  font-weight: 700;
  color: var(--ios-tint);
}

.opt-pill-t {
  flex: 1;
  padding-left: 12rpx;
  font-size: 30rpx;
  line-height: 1.45;
}

.judge-row {
  display: flex;
  gap: 20rpx;
  margin-top: 28rpx;
}

.judge-pill {
  flex: 1;
  text-align: center;
  padding: 28rpx 0;
  border-radius: 16rpx;
  font-size: 32rpx;
  font-weight: 600;
  background: rgba(60, 60, 67, 0.06);
  border: 2rpx solid transparent;
}

.judge-pill-on {
  background: rgba(0, 122, 255, 0.12);
  border-color: var(--ios-tint);
  color: var(--ios-tint);
}

.judge-pill-hover {
  opacity: 0.88;
}

.answer-area {
  margin-top: 24rpx;
  width: 100%;
  min-height: 200rpx;
  padding: 24rpx;
  box-sizing: border-box;
  border-radius: 16rpx;
  background: rgba(60, 60, 67, 0.06);
  font-size: 30rpx;
  line-height: 1.45;
}

.feedback-card {
  margin-top: 24rpx;
  padding: 28rpx;
}

.fb-title {
  display: block;
  font-size: 32rpx;
  font-weight: 700;
}

.fb-ok {
  color: var(--ios-green);
}

.fb-bad {
  color: var(--ios-red);
}

.fb-meta {
  display: block;
  margin-top: 12rpx;
  font-size: 26rpx;
}

.fb-exp {
  display: block;
  margin-top: 16rpx;
  font-size: 28rpx;
  line-height: 1.45;
  color: var(--ios-label);
}

.play-submit.disabled {
  opacity: 1;
}

.play-actions-row {
  display: flex;
  flex-direction: row;
  align-items: stretch;
  gap: 20rpx;
}

.play-submit-flex {
  flex: 1;
  min-width: 0;
  margin-top: 0;
}

.result-scroll {
  max-height: 58vh;
  margin-top: 8rpx;
}

.result-item {
  padding: 28rpx;
  margin-bottom: 20rpx;
}

.r-miss {
  font-size: 28rpx;
}

.r-stem {
  font-size: 30rpx;
  line-height: 1.45;
  font-weight: 500;
  white-space: pre-line;
}

.r-flag {
  display: block;
  margin-top: 12rpx;
  font-size: 28rpx;
  font-weight: 700;
}

.r-meta {
  display: block;
  margin-top: 8rpx;
  font-size: 24rpx;
}

.r-exp {
  display: block;
  margin-top: 12rpx;
  font-size: 26rpx;
  line-height: 1.45;
  color: var(--ios-label);
}

.catalog-wrap {
  display: flex;
  flex-direction: row;
  height: calc(100vh - 168rpx);
  min-height: 480rpx;
  background: #fff;
  border-radius: var(--ios-radius-card);
  overflow: hidden;
  box-shadow: var(--ios-shadow);
}

.catalog-left {
  width: 200rpx;
  flex-shrink: 0;
  background: #f2f2f7;
  max-height: 100%;
}

.unit-tab {
  padding: 28rpx 20rpx;
  font-size: 28rpx;
  color: #333;
  border-left: 6rpx solid transparent;
}

.unit-tab-on {
  background: #fff;
  color: #b45309;
  font-weight: 600;
  border-left-color: #c2410c;
}

.unit-tab-hover {
  background: rgba(0, 0, 0, 0.05);
}

.catalog-right {
  flex: 1;
  min-width: 0;
  max-height: 100%;
  background: #fff;
}

.point-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 32rpx 28rpx;
  border-bottom: 1rpx solid #eee;
}

.point-row-hover {
  background: rgba(0, 0, 0, 0.03);
}

.point-name {
  font-size: 30rpx;
  color: #111;
}

.point-chev {
  color: #ccc;
  font-size: 36rpx;
  font-weight: 300;
}

/* —— 图2：刷题模式四宫格 —— */
.style-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 24rpx;
  padding: 8rpx 0 24rpx;
}

.style-card {
  background: #fff;
  border-radius: 20rpx;
  padding: 36rpx 24rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.06);
  text-align: center;
  min-height: 220rpx;
  box-sizing: border-box;
}

.style-card-hover {
  opacity: 0.92;
}

.style-card-off {
  opacity: 0.45;
}

/* 四宫格图标：渐变蓝底 + 白色图形（统一色相与层次） */
.style-icon-box {
  width: 100rpx;
  height: 100rpx;
  margin: 0 auto 14rpx;
  border-radius: 30rpx;
  background: linear-gradient(155deg, #5cadff 0%, #2f95ff 28%, #007aff 72%, #0056c8 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  box-shadow: 0 8rpx 22rpx rgba(0, 122, 255, 0.32), inset 0 1rpx 0 rgba(255, 255, 255, 0.35);
}

.style-glyph {
  position: relative;
  box-sizing: border-box;
}

/* 顺序：递减横条 + 向右三角（依次推进） */
.style-glyph--seq {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  width: 56rpx;
  height: 44rpx;
}

.style-glyph-seq-col {
  display: flex;
  flex-direction: column;
  justify-content: center;
  gap: 8rpx;
}

.style-glyph-seq-bar {
  height: 8rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.96);
  box-shadow: 0 1rpx 2rpx rgba(0, 0, 0, 0.12);
  align-self: flex-start;
}

.style-glyph-seq-bar:nth-child(1) {
  width: 34rpx;
}

.style-glyph-seq-bar:nth-child(2) {
  width: 26rpx;
}

.style-glyph-seq-bar:nth-child(3) {
  width: 18rpx;
}

.style-glyph-seq-chev {
  width: 0;
  height: 0;
  border-style: solid;
  border-width: 10rpx 0 10rpx 13rpx;
  border-color: transparent transparent transparent rgba(255, 255, 255, 0.96);
  flex-shrink: 0;
}

/* 随机：两张叠放白卡片（洗牌感） */
.style-glyph--rnd {
  width: 52rpx;
  height: 46rpx;
}

.style-glyph-rnd-card {
  position: absolute;
  width: 32rpx;
  height: 38rpx;
  border-radius: 10rpx;
  background: rgba(255, 255, 255, 0.92);
  box-sizing: border-box;
  box-shadow: 0 3rpx 10rpx rgba(0, 0, 0, 0.2);
}

.style-glyph-rnd-card--a {
  left: 2rpx;
  top: 4rpx;
  transform: rotate(-16deg) scale(0.96);
  opacity: 0.72;
}

.style-glyph-rnd-card--b {
  right: 2rpx;
  bottom: 2rpx;
  transform: rotate(12deg);
}

/* 知识小节：圆点 + 横条 */
.style-glyph--sec {
  width: 48rpx;
  height: 42rpx;
  display: flex;
  flex-direction: column;
  justify-content: center;
  gap: 7rpx;
}

.style-glyph-sec-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 9rpx;
}

.style-glyph-sec-dot {
  width: 9rpx;
  height: 9rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.96);
  box-shadow: 0 1rpx 2rpx rgba(0, 0, 0, 0.12);
  flex-shrink: 0;
}

.style-glyph-sec-line {
  height: 7rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.92);
  box-shadow: 0 1rpx 2rpx rgba(0, 0, 0, 0.1);
}

.style-glyph-sec-line--w1 {
  width: 32rpx;
}

.style-glyph-sec-line--w2 {
  width: 26rpx;
}

.style-glyph-sec-line--w3 {
  width: 20rpx;
}

/* 模拟：留白缝的 2×2 白格（表格 / 配题） */
.style-glyph--mock {
  width: 44rpx;
  height: 44rpx;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  gap: 5rpx;
}

.style-glyph-mock-row {
  display: flex;
  flex-direction: row;
  justify-content: space-between;
  flex: 1;
  gap: 5rpx;
}

.style-glyph-mock-cell {
  flex: 1;
  min-height: 16rpx;
  background: rgba(255, 255, 255, 0.95);
  border-radius: 7rpx;
  box-shadow: 0 1rpx 3rpx rgba(0, 0, 0, 0.14);
}

.style-card-title {
  display: block;
  font-size: 30rpx;
  font-weight: 600;
  color: var(--ios-label);
}

.style-card-sub {
  display: block;
  margin-top: 12rpx;
  font-size: 22rpx;
  line-height: 1.35;
}

.empty-right {
  justify-content: center;
}

/* subsection-scroll 高度规则见上方 .mock-scroll 共用 */

.sub-row {
  display: flex;
  flex-direction: row;
  align-items: flex-start;
  padding: 28rpx 24rpx;
  border-bottom: 1rpx solid #eee;
  background: #fff;
  border-left: 6rpx solid transparent;
  box-sizing: border-box;
}

.sub-row-hover {
  background: rgba(0, 0, 0, 0.03);
}

.sub-row-on {
  background: rgba(194, 65, 12, 0.07);
  border-left-color: #c2410c;
}

.sub-row-on-hover {
  background: rgba(194, 65, 12, 0.1);
}

.sub-cb {
  width: 36rpx;
  height: 36rpx;
  border-radius: 8rpx;
  border: 2rpx solid #c7c7cc;
  margin-right: 20rpx;
  margin-top: 6rpx;
  flex-shrink: 0;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #fff;
}

.sub-cb-on {
  border-color: #c2410c;
  background: #c2410c;
}

.sub-cb-mark {
  font-size: 22rpx;
  font-weight: 700;
  color: #fff;
  line-height: 1;
}

.sub-main {
  flex: 1;
  min-width: 0;
}

.sub-title {
  display: block;
  font-size: 30rpx;
  font-weight: 600;
  color: #111;
}

.sub-progress {
  display: block;
  margin-top: 10rpx;
  font-size: 24rpx;
}

.sub-footer {
  position: fixed;
  left: 0;
  right: 0;
  bottom: calc(100rpx + env(safe-area-inset-bottom));
  padding: 20rpx 28rpx 20rpx;
  background: rgba(255, 255, 255, 0.96);
  border-top: 1rpx solid var(--ios-separator, rgba(60, 60, 67, 0.12));
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  z-index: 20;
  box-sizing: border-box;
  box-shadow: 0 -4rpx 24rpx rgba(0, 0, 0, 0.06);
}

.sub-footer-left {
  flex: 1;
  min-width: 0;
  padding-right: 16rpx;
}

.sub-footer-title {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
}

.sub-footer-sub {
  display: block;
  margin-top: 6rpx;
  font-size: 22rpx;
}

.sub-footer-btns {
  display: flex;
  flex-direction: row;
  gap: 16rpx;
  flex-shrink: 0;
}

