<wxs src="../../wxs/tags.wxs" module="tg" />

<view class="page-wrap quiz-root">
  <block wx:if="{{loading && step === 'play'}}">
    <text class="muted">加载题目…</text>
  </block>

  <block wx:elif="{{step === 'subject'}}">
    <text class="h1">选科目</text>
    <text class="lead muted">第一步</text>
    <view wx:for="{{subjects}}" wx:key="id" class="cell" bindtap="onPickSubject" data-id="{{item.id}}">
      <text class="cell-title">{{item.name}}</text>
      <text class="cell-arrow">›</text>
    </view>
  </block>

  <block wx:elif="{{step === 'tags'}}">
    <text class="h1">知识点</text>
    <text class="lead muted">可不选（全科目）；多选时为「任一」匹配</text>
    <view wx:for="{{tags}}" wx:key="key" class="cell" bindtap="onToggleTag" data-name="{{item.name}}">
      <text class="cell-title">{{item.unit_name}}{{item.unit_name ? ' · ' : ''}}{{item.name}}</text>
      <text class="check">{{tg.includes(selectedTags, item.name) ? '✓' : ''}}</text>
    </view>
    <view class="btn-primary mt" bindtap="fromTagsNext">下一步</view>
  </block>

  <block wx:elif="{{step === 'module'}}">
    <text class="h1">练习方式</text>
    <text class="lead muted">第三步</text>
    <view class="cell" bindtap="onPickModule" data-m="sequential">
      <view class="cell-main">
        <text class="cell-title">顺序练习</text>
        <text class="cell-sub muted">按题目 ID 升序</text>
      </view>
      <text class="cell-arrow">›</text>
    </view>
    <view class="cell" bindtap="onPickModule" data-m="random">
      <view class="cell-main">
        <text class="cell-title">随机练习</text>
        <text class="cell-sub muted">随机抽题</text>
      </view>
      <text class="cell-arrow">›</text>
    </view>
    <view class="cell" bindtap="onPickModule" data-m="section">
      <view class="cell-main">
        <text class="cell-title">知识小节练习</text>
        <text class="cell-sub muted">只练一个小节</text>
      </view>
      <text class="cell-arrow">›</text>
    </view>
    <view class="cell" bindtap="onPickModule" data-m="mock">
      <view class="cell-main">
        <text class="cell-title">模拟练习</text>
        <text class="cell-sub muted">按小节手动分配题数</text>
      </view>
      <text class="cell-arrow">›</text>
    </view>
  </block>

  <block wx:elif="{{step === 'section'}}">
    <text class="h1">选一个小节</text>
    <view wx:for="{{tags}}" wx:key="key" class="cell" bindtap="onPickSectionTag" data-name="{{item.name}}">
      <text class="cell-title">{{item.name}}</text>
      <text class="cell-arrow">›</text>
    </view>
  </block>

  <block wx:elif="{{step === 'mock'}}">
    <text class="h1">分配题数</text>
    <text class="lead muted">每个知识点抽题数量</text>
    <view wx:for="{{mockRows}}" wx:key="name" class="mock-row">
      <text class="mock-name">{{item.displayLabel}}</text>
      <input class="mock-input" type="number" value="{{item.countInput}}" data-name="{{item.name}}" bindinput="onMockCountInput" />
    </view>
    <view class="btn-primary mt" bindtap="fromMockNext">下一步</view>
  </block>

  <block wx:elif="{{step === 'mode'}}">
    <text class="h1">答题模式</text>
    <view class="cell" bindtap="onPickMode" data-m="immediate">
      <view class="cell-main">
        <text class="cell-title">及时反馈</text>
        <text class="cell-sub muted">每题提交后显示对错与解析</text>
      </view>
      <text class="cell-arrow">›</text>
    </view>
    <view class="cell" bindtap="onPickMode" data-m="exam">
      <view class="cell-main">
        <text class="cell-title">考试模式</text>
        <text class="cell-sub muted">全部做完后统一判分与看解析</text>
      </view>
      <text class="cell-arrow">›</text>
    </view>
  </block>

  <block wx:elif="{{step === 'play'}}">
    <view class="play-top">
      <text class="muted" bindtap="restartWizard">重选</text>
      <text class="play-num">{{currentIndex + 1}} / {{questionIds.length}}</text>
      <text class="muted">{{feedbackMode === 'exam' ? '考试' : '练习'}}</text>
    </view>
    <view class="progress-line"><view class="progress-inner" style="width: {{playProgress}}%;"></view></view>

    <block wx:if="{{currentQuestion}}">
      <text class="type-line muted">{{currentQuestion.question_type_text}}</text>
      <text class="stem">{{currentQuestion.stem}}</text>

      <block wx:if="{{currentQuestion.question_type === 1}}">
        <view wx:for="{{currentQuestion.options}}" wx:key="option_key" class="opt-row {{selectedAnswer === item.option_key ? 'opt-on' : ''}}" data-k="{{item.option_key}}" bindtap="onPickSingle">
          <text class="opt-k">{{item.option_key}}</text>
          <text class="opt-t">{{item.option_text}}</text>
        </view>
      </block>

      <block wx:if="{{currentQuestion.question_type === 2}}">
        <view wx:for="{{currentQuestion.options}}" wx:key="option_key" class="opt-row {{tg.includes(multiSelected, item.option_key) ? 'opt-on' : ''}}" data-k="{{item.option_key}}" bindtap="onToggleMulti">
          <text class="opt-k">{{item.option_key}}</text>
          <text class="opt-t">{{item.option_text}}</text>
        </view>
      </block>

      <block wx:if="{{currentQuestion.question_type === 3}}">
        <view class="judge-row">
          <view class="judge-btn {{selectedAnswer === 'A' || selectedAnswer === '对' ? 'opt-on' : ''}}" data-v="A" bindtap="onPickJudge">对</view>
          <view class="judge-btn {{selectedAnswer === 'B' || selectedAnswer === '错' ? 'opt-on' : ''}}" data-v="B" bindtap="onPickJudge">错</view>
        </view>
      </block>

      <block wx:if="{{currentQuestion.question_type === 4 || currentQuestion.question_type === 5}}">
        <textarea class="area" placeholder="请输入答案" value="{{textAnswer}}" bindinput="onTextAnswer" />
      </block>

      <block wx:if="{{feedbackMode === 'immediate' && submitted && checkResult}}">
        <view class="feedback divider-top">
          <text class="fb-line {{checkResult.correct ? 'ok' : 'bad'}}">{{checkResult.correct ? '回答正确' : '回答错误'}}</text>
          <text class="muted fb-small">参考答案：{{checkResult.correct_answer}}</text>
          <text class="fb-exp" wx:if="{{checkResult.explanation}}">解析：{{checkResult.explanation}}</text>
        </view>
      </block>

      <view class="btn-primary mt {{playBtnDisabled ? 'disabled' : ''}}" bindtap="onPlayPrimary">{{playBtnLabel}}</view>
    </block>
  </block>

  <block wx:elif="{{step === 'exam_result'}}">
    <text class="h1">交卷结果</text>
    <text class="lead muted">共 {{examResults.length}} 题</text>
    <scroll-view scroll-y class="result-scroll">
      <view wx:for="{{examResults}}" wx:key="question_id" class="result-card">
        <text class="muted" wx:if="{{item.missing}}">题目 {{item.question_id}} 缺失</text>
        <block wx:else>
          <text class="r-stem">{{item.stem}}</text>
          <text class="r-line {{item.correct ? 'ok' : 'bad'}}">{{item.correct ? '正确' : '错误'}}</text>
          <text class="muted r-small">你的答案：{{item.user_answer || '（空）'}}</text>
          <text class="muted r-small">参考答案：{{item.correct_answer}}</text>
          <text class="r-exp" wx:if="{{item.explanation}}">解析：{{item.explanation}}</text>
        </block>
      </view>
    </scroll-view>
    <view class="btn-primary mt" bindtap="restartWizard">完成</view>
  </block>
</view>
