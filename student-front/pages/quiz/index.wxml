<wxs src="../../wxs/tags.wxs" module="tg" />

<view class="page-wrap quiz-root">
  <block wx:if="{{loading && step === 'play'}}">
    <view class="loading-pill muted">加载题目…</view>
  </block>

  <block wx:elif="{{step === 'catalog'}}">
    <view class="page-hero catalog-hero page-hero--catalog-root">
      <view class="page-hero-accent"></view>
      <view class="page-hero-body">
        <text class="page-hero-title">刷题</text>
        <text class="page-hero-lead muted">选择科目与单元</text>
      </view>
    </view>
    <view class="catalog-wrap">
      <scroll-view scroll-y class="catalog-left">
        <view
          wx:for="{{subjects}}"
          wx:key="id"
          class="unit-tab {{subjectId == item.id ? 'unit-tab-on' : ''}}"
          bindtap="onPickSubjectLeft"
          data-id="{{item.id}}"
        >
          {{item.name}}
        </view>
      </scroll-view>
      <scroll-view scroll-y class="catalog-right">
        <view wx:if="{{!units.length}}" class="point-row empty-right">
          <text class="muted">该科目下暂无知识单元</text>
        </view>
        <view
          wx:for="{{units}}"
          wx:key="id"
          class="point-row"
          bindtap="onPickKnowledgeUnit"
          data-id="{{item.id}}"
          data-name="{{item.name}}"
        >
          <text class="point-name">{{item.name}}</text>
          <text class="point-chev">›</text>
        </view>
      </scroll-view>
    </view>
  </block>

  <!-- 刷题模式四宫格：针对当前知识单元 -->
  <block wx:elif="{{step === 'practice_style'}}">
    <view class="nav-row nav-back-row" bindtap="backFromPracticeStyle">
      <text class="nav-back">‹</text>
      <text class="nav-back-hint">返回上一级</text>
    </view>
    <view class="page-hero page-hero--compact">
      <view class="page-hero-accent"></view>
      <view class="page-hero-body">
        <text class="page-hero-title page-hero-title--unit">{{unitName}}</text>
        <text class="page-hero-meta muted">共 {{topicQuestionCount}} 题</text>
      </view>
    </view>
    <view class="style-grid">
      <view
        class="style-card"
        bindtap="onStyleCardTap"
        bindlongtap="onStyleCardLongExam"
        data-m="sequential"
      >
        <view class="style-icon-box">
          <view class="style-glyph style-glyph--seq">
            <view class="style-glyph-seq-col">
              <view class="style-glyph-seq-bar"></view>
              <view class="style-glyph-seq-bar"></view>
              <view class="style-glyph-seq-bar"></view>
            </view>
            <view class="style-glyph-seq-chev"></view>
          </view>
        </view>
        <text class="style-card-title">顺序练习</text>
        <text class="style-card-sub muted">{{seqProgressHint}}</text>
      </view>
      <view class="style-card" bindtap="onStyleCardTap" bindlongtap="onStyleCardLongExam" data-m="random">
        <view class="style-icon-box">
          <view class="style-glyph style-glyph--rnd">
            <view class="style-glyph-rnd-card style-glyph-rnd-card--a"></view>
            <view class="style-glyph-rnd-card style-glyph-rnd-card--b"></view>
          </view>
        </view>
        <text class="style-card-title">随机练习</text>
        <text class="style-card-sub muted">本单元内题目顺序打乱</text>
      </view>
      <view class="style-card" bindtap="onStyleCardTap" data-m="section">
        <view class="style-icon-box">
          <view class="style-glyph style-glyph--sec">
            <view class="style-glyph-sec-row">
              <view class="style-glyph-sec-dot"></view>
              <view class="style-glyph-sec-line style-glyph-sec-line--w1"></view>
            </view>
            <view class="style-glyph-sec-row">
              <view class="style-glyph-sec-dot"></view>
              <view class="style-glyph-sec-line style-glyph-sec-line--w2"></view>
            </view>
            <view class="style-glyph-sec-row">
              <view class="style-glyph-sec-dot"></view>
              <view class="style-glyph-sec-line style-glyph-sec-line--w3"></view>
            </view>
          </view>
        </view>
        <text class="style-card-title">知识小节</text>
        <text class="style-card-sub muted">按知识点（知识小节）练习</text>
      </view>
      <view class="style-card" bindtap="onStyleCardTap" data-m="mock">
        <view class="style-icon-box">
          <view class="style-glyph style-glyph--mock">
            <view class="style-glyph-mock-row">
              <view class="style-glyph-mock-cell"></view>
              <view class="style-glyph-mock-cell"></view>
            </view>
            <view class="style-glyph-mock-row">
              <view class="style-glyph-mock-cell"></view>
              <view class="style-glyph-mock-cell"></view>
            </view>
          </view>
        </view>
        <text class="style-card-title">模拟练习</text>
        <text class="style-card-sub muted">各知识点自定义抽题</text>
      </view>
    </view>
    <text class="ui-callout">顺序 / 随机：短按后选反馈方式；长按可快捷进入考试模式。知识小节请勾选后点「立即刷题」。</text>
  </block>

  <!-- 知识小节 = 知识点列表 -->
  <block wx:elif="{{step === 'subsections'}}">
    <view class="nav-row nav-back-row" bindtap="backFromSubsections">
      <text class="nav-back">‹</text>
      <text class="nav-back-hint">返回上一级</text>
    </view>
    <view class="page-hero page-hero--compact">
      <view class="page-hero-accent"></view>
      <view class="page-hero-body">
        <text class="page-hero-title page-hero-title--unit">{{unitName}}</text>
        <text class="page-hero-meta muted">共 {{topicQuestionCount}} 题</text>
      </view>
    </view>
    <scroll-view scroll-y class="subsection-scroll">
      <view
        wx:for="{{subsectionRows}}"
        wx:key="id"
        class="sub-row {{tg.includesId(selectedSectionTagIds, item.id) ? 'sub-row-on' : ''}}"
        bindtap="onToggleSectionTag"
        data-id="{{item.id}}"
        data-name="{{item.name}}"
      >
        <view class="sub-cb {{tg.includesId(selectedSectionTagIds, item.id) ? 'sub-cb-on' : ''}}">
          <text wx:if="{{tg.includesId(selectedSectionTagIds, item.id)}}" class="sub-cb-mark">✓</text>
        </view>
        <view class="sub-main">
          <text class="sub-title">{{item.name}}</text>
          <text class="sub-progress muted">{{item.progressText}}</text>
        </view>
      </view>
      <view wx:if="{{!subsectionRows.length}}" class="point-row empty-right">
        <text class="muted">暂无知识小节</text>
      </view>
    </scroll-view>
    <text class="ui-callout">勾选后点「立即刷题」；顺序刷题时可在做题页点「跳转」到指定题号。</text>
    <view class="sub-footer">
      <view class="sub-footer-left">
        <text class="sub-footer-title">知识小节</text>
        <text class="sub-footer-sub muted">可多选，再点一次取消勾选</text>
      </view>
      <view class="sub-footer-btns">
        <view class="ui-row-btn ui-row-btn--ghost ui-row-btn--back" bindtap="backFromSubsections">
          <text class="ui-row-btn-chevron">‹</text>
          <text>返回上一级</text>
        </view>
        <view class="ui-row-btn ui-row-btn--primary" bindtap="startSectionPracticeNow">立即刷题</view>
      </view>
    </view>
  </block>

  <block wx:elif="{{step === 'mock'}}">
    <view class="nav-row nav-back-row" bindtap="backFromMock">
      <text class="nav-back">‹</text>
      <text class="nav-back-hint">返回上一级</text>
    </view>
    <view class="page-hero page-hero--compact">
      <view class="page-hero-accent"></view>
      <view class="page-hero-body">
        <text class="page-hero-eyebrow">模拟练习</text>
        <text class="page-hero-title">分配题数</text>
        <text class="page-hero-lead muted">填写各知识点抽题数；0 表示不抽。每点不超过本题库题量，单次每点最多 50 题。</text>
      </view>
    </view>
    <scroll-view scroll-y class="mock-scroll" show-scrollbar="{{false}}">
      <view wx:for="{{mockRows}}" wx:key="name" class="mock-card">
        <text class="mock-card-title">{{item.displayLabel}}</text>
        <text class="mock-card-bank muted">本题库该点共 {{item.bankCount}} 题 · 本次最多可填 {{item.maxCount}} 题</text>
        <view class="mock-field">
          <text class="mock-field-caption">抽题数量</text>
          <input
            class="mock-field-input {{item.maxCount <= 0 ? 'mock-field-input-off' : ''}}"
            type="number"
            placeholder="{{item.countPlaceholder}}"
            placeholder-class="mock-ph"
            value="{{item.countInput}}"
            disabled="{{item.maxCount <= 0}}"
            data-name="{{item.name}}"
            data-max="{{item.maxCount}}"
            bindinput="onMockCountInput"
            bindblur="onMockCountBlur"
            adjust-position="{{true}}"
          />
        </view>
      </view>
    </scroll-view>
    <view class="btn-primary mt" bindtap="fromMockNext">下一步</view>
  </block>

  <block wx:elif="{{step === 'play'}}">
    <view class="ui-toolbar">
      <view class="ui-chip ui-chip--tint" bindtap="restartWizard">返回上一级</view>
      <block wx:if="{{practiceModule === 'sequential'}}">
        <view class="ui-toolbar-mid">
          <text class="ui-stat">{{currentIndex + 1}} / {{questionIds.length}}</text>
          <view class="ui-chip ui-chip--tint" bindtap="openSeqJump">跳转</view>
        </view>
      </block>
      <block wx:else>
        <view class="ui-toolbar-mid">
          <text class="ui-stat">{{currentIndex + 1}} / {{questionIds.length}}</text>
        </view>
      </block>
      <text class="ui-mode {{feedbackMode === 'exam' ? 'ui-mode--exam' : 'ui-mode--practice'}}">{{feedbackMode === 'exam' ? '考试' : '练习'}}</text>
    </view>
    <view class="progress-track">
      <view class="progress-fill" style="width: {{playProgress}}%;"></view>
    </view>
    <text wx:if="{{practiceModule === 'sequential'}}" class="ui-callout ui-callout--center">顺序刷题：点「跳转」输入题号</text>

    <block wx:if="{{currentQuestion}}">
      <view class="ios-card play-card">
        <text class="type-pill muted">{{currentQuestion.question_type_text}}</text>
        <text class="stem-text">{{currentQuestion.stem}}</text>

        <block wx:if="{{currentQuestion.question_type === 1}}">
          <view wx:for="{{currentQuestion.options}}" wx:key="option_key" class="opt-pill {{selectedAnswer === item.option_key ? 'opt-pill-on' : ''}}" data-k="{{item.option_key}}" bindtap="onPickSingle">
            <text class="opt-pill-k">{{item.option_key}}</text>
            <text class="opt-pill-t">{{item.option_text}}</text>
          </view>
        </block>

        <block wx:if="{{currentQuestion.question_type === 2}}">
          <view wx:for="{{currentQuestion.options}}" wx:key="option_key" class="opt-pill {{tg.includes(multiSelected, item.option_key) ? 'opt-pill-on' : ''}}" data-k="{{item.option_key}}" bindtap="onToggleMulti">
            <text class="opt-pill-k">{{item.option_key}}</text>
            <text class="opt-pill-t">{{item.option_text}}</text>
          </view>
        </block>

        <block wx:if="{{currentQuestion.question_type === 3}}">
          <view class="judge-row">
            <view class="judge-pill {{selectedAnswer === 'A' || selectedAnswer === '对' ? 'judge-pill-on' : ''}}" data-v="A" bindtap="onPickJudge">对</view>
            <view class="judge-pill {{selectedAnswer === 'B' || selectedAnswer === '错' ? 'judge-pill-on' : ''}}" data-v="B" bindtap="onPickJudge">错</view>
          </view>
        </block>

        <block wx:if="{{currentQuestion.question_type === 4 || currentQuestion.question_type === 5}}">
          <textarea class="answer-area" placeholder="请输入答案" placeholder-class="ph" value="{{textAnswer}}" bindinput="onTextAnswer" />
        </block>
      </view>

      <block wx:if="{{feedbackMode === 'immediate' && submitted && checkResult}}">
        <view class="ios-card feedback-card">
          <text class="fb-title {{checkResult.correct ? 'fb-ok' : 'fb-bad'}}">{{checkResult.correct ? '回答正确' : '回答错误'}}</text>
          <text class="fb-meta muted">参考答案：{{checkResult.correct_answer}}</text>
          <text class="fb-exp" wx:if="{{checkResult.explanation}}">解析：{{checkResult.explanation}}</text>
        </view>
      </block>

      <block wx:if="{{feedbackMode === 'exam' && currentIndex > 0}}">
        <view class="play-actions-row mt">
          <view class="ui-btn-secondary" bindtap="onExamPrev">上一题</view>
          <view class="btn-primary play-submit play-submit-flex {{playBtnDisabled ? 'disabled' : ''}}" bindtap="onPlayPrimary">{{playBtnLabel}}</view>
        </view>
      </block>
      <block wx:else>
        <view class="btn-primary mt play-submit {{playBtnDisabled ? 'disabled' : ''}}" bindtap="onPlayPrimary">{{playBtnLabel}}</view>
      </block>
    </block>

    <view wx:if="{{seqJumpOpen}}" class="seq-jump-mask" catchtouchmove="noop" bindtap="closeSeqJump">
      <view class="seq-jump-card" catchtap="noop">
        <text class="seq-jump-title">跳转到题号</text>
        <text class="seq-jump-range muted">请输入 1～{{questionIds.length}}（当前顺序刷题）</text>
        <input
          class="seq-jump-input"
          type="number"
          focus="{{seqJumpOpen}}"
          value="{{seqJumpInput}}"
          bindinput="onSeqJumpInput"
        />
        <view class="ui-modal-actions">
          <view class="ui-modal-btn ui-modal-btn--cancel" bindtap="closeSeqJump">取消</view>
          <view class="ui-modal-btn ui-modal-btn--ok" bindtap="confirmSeqJump">确定</view>
        </view>
      </view>
    </view>
  </block>

  <block wx:elif="{{step === 'exam_result'}}">
    <view class="page-hero page-hero--compact">
      <view class="page-hero-accent"></view>
      <view class="page-hero-body">
        <text class="page-hero-eyebrow">考试模式</text>
        <text class="page-hero-title">交卷结果</text>
        <text class="page-hero-meta muted">共 {{examResults.length}} 题</text>
      </view>
    </view>
    <scroll-view scroll-y class="result-scroll">
      <view wx:for="{{examResults}}" wx:key="question_id" class="ios-card result-item">
        <text class="muted r-miss" wx:if="{{item.missing}}">题目 {{item.question_id}} 缺失</text>
        <block wx:else>
          <text class="r-stem">{{item.stem}}</text>
          <text class="r-flag {{item.correct ? 'fb-ok' : 'fb-bad'}}">{{item.correct ? '正确' : '错误'}}</text>
          <text class="r-meta muted">你的答案：{{item.user_answer || '（空）'}}</text>
          <text class="r-meta muted">参考答案：{{item.correct_answer}}</text>
          <text class="r-exp" wx:if="{{item.explanation}}">解析：{{item.explanation}}</text>
        </block>
      </view>
    </scroll-view>
    <view class="btn-primary mt" bindtap="restartWizard">返回上一级</view>
  </block>
</view>
