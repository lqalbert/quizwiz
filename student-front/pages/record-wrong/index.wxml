<view class="page-wrap record-page">
  <view class="step-head">
    <text class="page-hero">错题本</text>
    <text class="empty-hint muted" wx:if="{{!list.length && !loading}}">暂无错题记录，继续刷题后会出现在这里</text>
    <text class="record-count muted" wx:elif="{{list.length}}">共 {{list.length}} 题</text>
  </view>

  <view
    wx:for="{{list}}"
    wx:key="question_id"
    class="ios-card record-card record-card-tap"
    bindtap="onRetryTap"
    data-qid="{{item.question_id}}"
  >
    <text class="record-stem line-clamp">{{item.stem}}</text>
    <text class="record-meta muted">{{item.question_type_text}} · 做过 {{item.attempts}} 次 · 对 {{item.correct_count}} / 错 {{item.wrong_count}}</text>
    <text class="record-action">点击再练</text>
  </view>
</view>
