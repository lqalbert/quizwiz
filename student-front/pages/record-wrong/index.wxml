<view class="page-wrap record-root quiz-root">
  <block wx:if="{{step === 'catalog'}}">
    <view class="page-hero record-catalog-hero page-hero--catalog-root">
      <view class="page-hero-accent"></view>
      <view class="page-hero-body">
        <text class="page-hero-title">错题本</text>
        <text class="page-hero-lead muted">选择科目与单元</text>
      </view>
    </view>
    <view class="catalog-wrap">
      <scroll-view scroll-y class="catalog-left">
        <view
          wx:for="{{subjects}}"
          wx:key="id"
          class="unit-tab {{subjectId == item.id ? 'unit-tab-on' : ''}}"
          bindtap="onPickSubjectLeft"
          data-id="{{item.id}}"
        >
          {{item.name}}
        </view>
      </scroll-view>
      <scroll-view scroll-y class="catalog-right">
        <view wx:if="{{!units.length}}" class="ios-card record-catalog-empty">
          <text class="record-empty-title">该科目下暂无知识单元</text>
          <text class="muted">可换一个科目，或稍后再试。</text>
        </view>
        <view
          wx:for="{{units}}"
          wx:key="id"
          class="point-row"
          bindtap="onPickKnowledgeUnit"
          data-id="{{item.id}}"
          data-name="{{item.name}}"
        >
          <text class="point-name">{{item.name}}</text>
          <text class="point-chev">›</text>
        </view>
      </scroll-view>
    </view>
  </block>

  <block wx:else>
    <view class="nav-row nav-back-row" bindtap="backFromList">
      <text class="nav-back">‹</text>
      <text class="nav-back-hint">返回上一级</text>
    </view>
    <view class="page-hero page-hero--compact">
      <view class="page-hero-accent"></view>
      <view class="page-hero-body">
        <text class="page-hero-title page-hero-title--unit">{{unitName}}</text>
        <text class="page-hero-meta muted" wx:if="{{!listLoading}}">共 {{pagination.total}} 题</text>
      </view>
    </view>
    <view wx:if="{{list.length}}" class="batch-bar">
      <view class="ui-strip-btn" bindtap="onBatchWrongPractice">本单元错题一起练</view>
    </view>
    <view wx:if="{{listLoading}}" class="loading-pill muted">加载中…</view>
    <view wx:elif="{{!list.length}}" class="ios-card record-empty-card">
      <text class="record-empty-title">该单元暂无错题</text>
      <text class="muted record-empty-desc">去刷题做题后，错题会自动进入本页；也可到首页查看「今日待复习」。</text>
      <view class="record-empty-actions">
        <view class="ui-btn-secondary record-empty-btn" bindtap="goReviewToday">今日待复习</view>
        <view class="btn-primary record-empty-btn" bindtap="goBrowseQuiz">去刷题</view>
      </view>
    </view>
    <scroll-view
      wx:else
      scroll-y
      class="wrong-list-scroll"
      lower-threshold="120"
      bindscrolltolower="onWrongScrollToLower"
    >
      <view wx:for="{{list}}" wx:key="question_id" class="ios-card record-card">
        <text class="record-stem line-clamp">{{item.stem}}</text>
        <text class="record-meta muted">{{item.question_type_text}} · 做过 {{item.attempts}} 次 · 错 {{item.wrong_count}}</text>
        <view class="record-actions">
          <view class="ui-link-btn ui-link-btn--muted" catchtap="onRemoveWrong" data-qid="{{item.question_id}}">移出错题本</view>
          <view class="ui-link-btn ui-link-btn--tint" catchtap="onRetryTap" data-qid="{{item.question_id}}">再练</view>
        </view>
      </view>
      <view wx:if="{{list.length && hasMore}}" class="load-more-wrap">
        <text wx:if="{{listLoadingMore}}" class="muted load-more-text">加载更多…</text>
        <text wx:else class="load-more-tap muted" bindtap="onLoadMoreWrong">点击加载更多</text>
      </view>
      <view wx:if="{{list.length && !hasMore}}" class="load-more-wrap">
        <text class="muted load-more-text">已加载全部</text>
      </view>
    </scroll-view>
  </block>
</view>
