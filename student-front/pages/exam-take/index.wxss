.exam-take-page {
  padding-top: 8rpx;
  padding-bottom: constant(safe-area-inset-bottom);
  padding-bottom: env(safe-area-inset-bottom);
}

.exam-topbar {
  display: flex;
  flex-direction: row;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 12rpx;
}

.exam-topbar-title {
  flex: 1;
  min-width: 0;
  font-size: 30rpx;
  font-weight: 700;
  color: var(--ios-label);
  line-height: 1.35;
}

.exam-topbar-timer {
  flex-shrink: 0;
  font-size: 24rpx;
  font-weight: 600;
  color: var(--ios-secondary);
}

.exam-topbar-timer--warn {
  color: #ff3b30;
}

.exam-banner {
  margin-bottom: 12rpx;
  padding: 16rpx 20rpx;
  border-radius: 12rpx;
  font-size: 24rpx;
  line-height: 1.45;
  box-sizing: border-box;
}

.exam-banner--warn {
  background: rgba(255, 149, 0, 0.14);
  color: #c2410c;
  border: 1rpx solid rgba(255, 149, 0, 0.35);
}

.exam-banner--muted {
  background: rgba(60, 60, 67, 0.06);
  color: var(--ios-secondary);
  border: 1rpx solid var(--ios-separator);
}

.exam-nav {
  margin-bottom: 12rpx;
}

.exam-nav-stat {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--ios-secondary);
}

.progress-track {
  height: 6rpx;
  background: rgba(60, 60, 67, 0.12);
  border-radius: 6rpx;
  margin-bottom: 16rpx;
  overflow: hidden;
}

.progress-fill {
  height: 100%;
  background: var(--ios-tint);
  border-radius: 6rpx;
  transition: width 0.2s ease;
}

.play-card {
  padding: 32rpx 28rpx 28rpx;
}

.type-pill {
  display: inline-block;
  font-size: 22rpx;
  font-weight: 600;
  letter-spacing: 0.06em;
  margin-bottom: 16rpx;
}

.stem-text {
  display: block;
  font-size: 32rpx;
  font-weight: 500;
  line-height: 1.5;
  letter-spacing: -0.01em;
  white-space: pre-line;
}

.opt-pill {
  display: flex;
  align-items: flex-start;
  margin-top: 20rpx;
  padding: 28rpx 24rpx;
  border-radius: 16rpx;
  background: rgba(60, 60, 67, 0.06);
  border: 2rpx solid transparent;
  box-sizing: border-box;
}

.opt-pill-hover {
  opacity: 0.9;
}

.opt-pill-on {
  background: rgba(0, 122, 255, 0.1);
  border-color: var(--ios-tint);
}

.opt-pill-k {
  width: 44rpx;
  flex-shrink: 0;
  font-size: 28rpx;
  font-weight: 700;
  color: var(--ios-tint);
}

.opt-pill-t {
  flex: 1;
  padding-left: 12rpx;
  font-size: 30rpx;
  line-height: 1.45;
}

.judge-row {
  display: flex;
  gap: 20rpx;
  margin-top: 28rpx;
}

.judge-pill {
  flex: 1;
  text-align: center;
  padding: 28rpx 0;
  border-radius: 16rpx;
  font-size: 32rpx;
  font-weight: 600;
  background: rgba(60, 60, 67, 0.06);
  border: 2rpx solid transparent;
}

.judge-pill-on {
  background: rgba(0, 122, 255, 0.12);
  border-color: var(--ios-tint);
  color: var(--ios-tint);
}

.judge-pill-hover {
  opacity: 0.88;
}

.answer-area {
  margin-top: 24rpx;
  width: 100%;
  min-height: 200rpx;
  padding: 24rpx;
  box-sizing: border-box;
  border-radius: 16rpx;
  background: rgba(60, 60, 67, 0.06);
  font-size: 30rpx;
  line-height: 1.45;
}

/* 与题目区拉开距离，避免误触选项时碰到交卷 */
.exam-footer {
  margin-top: 40rpx;
  padding-top: 28rpx;
  border-top: 1rpx solid var(--ios-separator);
}

.exam-nav-card {
  padding: 20rpx;
  margin-bottom: 0;
}

.exam-nav-row {
  display: flex;
  flex-direction: row;
  align-items: stretch;
  gap: 20rpx;
}

.exam-nav-pill {
  flex: 1;
  min-height: 88rpx;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: var(--ios-radius-btn);
  font-size: 30rpx;
  font-weight: 600;
  color: var(--ios-tint);
  background: rgba(0, 122, 255, 0.1);
  border: 2rpx solid rgba(0, 122, 255, 0.35);
}

.exam-nav-pill-hover {
  opacity: 0.88;
}

.exam-nav-pill--disabled {
  color: var(--ios-tertiary);
  background: rgba(60, 60, 67, 0.06);
  border-color: transparent;
  pointer-events: none;
}

.exam-submit-slot {
  margin-top: 28rpx;
  padding-bottom: 12rpx;
}

.exam-submit-pill {
  width: 100%;
  box-sizing: border-box;
  min-height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: var(--ios-radius-btn);
  font-size: 30rpx;
  font-weight: 600;
  color: #fff;
  background: linear-gradient(180deg, #ff6b6b 0%, #e03131 100%);
  box-shadow: 0 6rpx 20rpx rgba(224, 49, 49, 0.28);
}

.exam-submit-pill-hover {
  opacity: 0.9;
}

.exam-submit-pill--disabled {
  opacity: 0.55;
  pointer-events: none;
}

.exam-review-hero {
  margin-bottom: 16rpx;
}

.exam-review-progress {
  background: linear-gradient(90deg, #7c5cff 0%, #5856d6 100%);
}

.opt-pill--review {
  pointer-events: none;
}

.opt-pill--review-correct {
  border-color: rgba(52, 199, 89, 0.85) !important;
  background: rgba(52, 199, 89, 0.12) !important;
}

.opt-pill--review-wrong {
  border-color: rgba(255, 59, 48, 0.85) !important;
  background: rgba(255, 59, 48, 0.1) !important;
}

.answer-area--readonly {
  margin-top: 24rpx;
  white-space: pre-wrap;
  word-break: break-word;
  color: var(--ios-label);
}

.review-answer-block {
  margin-top: 28rpx;
  padding-top: 24rpx;
  border-top: 1rpx solid var(--ios-separator);
}

.exam-footer--review {
  border-top: none;
  margin-top: 28rpx;
  padding-top: 0;
}

.exam-submit-pill--secondary {
  background: rgba(60, 60, 67, 0.1);
  color: var(--ios-label);
  box-shadow: none;
  border: 2rpx solid rgba(60, 60, 67, 0.14);
}

.r-stem {
  font-size: 30rpx;
  line-height: 1.45;
  font-weight: 500;
  white-space: pre-line;
}

.r-flag {
  display: block;
  margin-top: 12rpx;
  font-size: 28rpx;
  font-weight: 700;
}

.r-meta {
  display: block;
  margin-top: 8rpx;
  font-size: 24rpx;
}

.r-exp {
  display: block;
  margin-top: 12rpx;
  font-size: 26rpx;
  line-height: 1.45;
  color: var(--ios-label);
}

.fb-ok {
  color: var(--ios-green);
}

.fb-bad {
  color: var(--ios-red);
}

.exam-back {
  margin-top: 28rpx;
}

.exam-err {
  text-align: center;
  padding: 48rpx 24rpx;
  font-size: 28rpx;
}

.mt {
  margin-top: 36rpx;
}

.ph {
  color: rgba(60, 60, 67, 0.42);
}
