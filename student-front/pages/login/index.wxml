<view class="page-wrap login-page">
  <view class="hero-block">
    <text class="hero-title">欢迎使用</text>
    <text class="hero-lead muted">点击下方按钮，在弹窗中点「允许」即可完成登录；入班信息在首页填写。</text>
  </view>

  <view class="ios-card pad-card">
    <text class="muted">我们将获取你的微信头像与昵称，用于个人中心展示，不会用于其他用途。</text>
  </view>

  <button
    class="btn-primary login-action"
    hover-class="btn-primary-hover"
    hover-stay-time="70"
    loading="{{_loginInFlight}}"
    disabled="{{_loginInFlight}}"
    bindtap="onTapWechatLogin"
  >
    确认登录
  </button>
</view>
