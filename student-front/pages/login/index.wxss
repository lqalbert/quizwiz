.login-page {
  padding-top: 16rpx;
}

.pad-card {
  padding: 28rpx 28rpx;
}

.hero-block {
  margin-bottom: 40rpx;
}

.hero-title {
  display: block;
  font-size: 52rpx;
  font-weight: 700;
  letter-spacing: -0.03em;
  line-height: 1.15;
}

.hero-lead {
  display: block;
  margin-top: 16rpx;
  font-size: 28rpx;
  line-height: 1.45;
}

.field-row {
  display: flex;
  align-items: center;
  padding: 28rpx 28rpx;
  min-height: 100rpx;
  box-sizing: border-box;
}

.field-row-single {
  padding-top: 32rpx;
  padding-bottom: 32rpx;
}

.field-label {
  width: 140rpx;
  flex-shrink: 0;
  font-size: 30rpx;
  font-weight: 500;
  color: var(--ios-label);
}

.field-input {
  flex: 1;
  min-width: 0;
  font-size: 32rpx;
  color: var(--ios-label);
}

.field-input-full {
  width: 100%;
}

.ph {
  color: var(--ios-tertiary);
}

.login-action {
  margin-top: 40rpx;
}

.join-btn {
  margin-top: 40rpx;
}

.link-row {
  display: block;
  margin-top: 28rpx;
  text-align: center;
  font-size: 28rpx;
}

.muted-link {
  color: var(--ios-secondary);
  font-weight: 400;
}

.muted-link:active {
  opacity: 0.65;
}
