.login-page {
  padding-top: 16rpx;
}

.pad-card {
  padding: 28rpx 28rpx;
}

.hero-block {
  margin-bottom: 40rpx;
}

.hero-title {
  display: block;
  font-size: 52rpx;
  font-weight: 700;
  letter-spacing: -0.03em;
  line-height: 1.15;
}

.hero-lead {
  display: block;
  margin-top: 16rpx;
  font-size: 28rpx;
  line-height: 1.45;
}

.field-row {
  display: flex;
  align-items: center;
  padding: 28rpx 28rpx;
  min-height: 100rpx;
  box-sizing: border-box;
}

.field-row-single {
  padding-top: 32rpx;
  padding-bottom: 32rpx;
}

.field-label {
  width: 140rpx;
  flex-shrink: 0;
  font-size: 30rpx;
  font-weight: 500;
  color: var(--ios-label);
}

.field-input {
  flex: 1;
  min-width: 0;
  font-size: 32rpx;
  color: var(--ios-label);
}

.field-input-full {
  width: 100%;
}

.ph {
  color: var(--ios-tertiary);
}

.profile-setup-card {
  margin-bottom: 24rpx;
}

.profile-setup-row {
  display: flex;
  align-items: center;
  gap: 28rpx;
}

.avatar-choose-btn {
  padding: 0;
  margin: 0;
  border: none;
  background: transparent;
  line-height: 1;
  flex-shrink: 0;
}

.avatar-choose-btn::after {
  border: none;
}

.avatar-preview {
  width: 112rpx;
  height: 112rpx;
  border-radius: 50%;
  display: block;
  background: #e8e8ed;
}

.avatar-preview--placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  color: var(--ios-secondary);
}

.profile-setup-fields {
  flex: 1;
  min-width: 0;
}

.profile-setup-label {
  display: block;
  font-size: 26rpx;
  color: var(--ios-secondary);
  margin-bottom: 12rpx;
}

.profile-nickname-input {
  width: 100%;
  font-size: 32rpx;
  color: var(--ios-label);
  min-height: 48rpx;
}

.login-action {
  margin-top: 40rpx;
}

.join-btn {
  margin-top: 40rpx;
}

.link-row {
  display: block;
  margin-top: 28rpx;
  text-align: center;
  font-size: 28rpx;
}

.muted-link {
  color: var(--ios-secondary);
  font-weight: 400;
}

.muted-link-hover {
  opacity: 0.65;
}
