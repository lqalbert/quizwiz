.login-page {
  padding-top: 16rpx;
}

.hero-block {
  margin-bottom: 40rpx;
}

.hero-title {
  display: block;
  font-size: 52rpx;
  font-weight: 700;
  letter-spacing: -0.03em;
  line-height: 1.15;
}

.hero-lead {
  display: block;
  margin-top: 16rpx;
  font-size: 28rpx;
  line-height: 1.45;
}

.pad-card {
  padding: 28rpx 28rpx;
}

.login-auth-desc {
  display: block;
  font-size: 26rpx;
  line-height: 1.45;
}

.login-action {
  margin-top: 40rpx;
  width: 100%;
  box-sizing: border-box;
  border: none;
  font-size: 32rpx;
  font-weight: 600;
  line-height: 1.2;
}

.login-action::after {
  border: none;
}
