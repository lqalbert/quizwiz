<view class="page-wrap home-page">
  <view class="page-hero home-hero">
    <view class="page-hero-accent"></view>
    <view class="page-hero-body">
      <text class="page-hero-date">{{dateText}}</text>
      <text class="page-hero-title">今天练几题？</text>
      <text class="page-hero-lead muted">可自由浏览各功能；开始刷题时需登录，入班请在「我的」完成</text>
    </view>
  </view>

  <view wx:if="{{!loggedIn}}" class="ios-card home-browse-tip">
    <text class="home-browse-tip-text muted">当前为浏览模式，登录后可同步个人刷题与考试数据</text>
    <view class="link-tint home-browse-login tap-link" hover-class="link-tint-hover" hover-stay-time="70" bindtap="goLogin">去登录</view>
  </view>

  <view wx:if="{{loggedIn && homeGuideVisible}}" class="ios-card home-guide-card">
    <view class="home-guide-head">
      <text class="home-guide-title">快速了解</text>
      <view class="home-guide-dismiss link-tint tap-link" hover-class="link-tint-hover" hover-stay-time="70" bindtap="dismissHomeGuide">知道了</view>
    </view>
    <text class="home-guide-line muted">「刷题」卡片可切换今日/本周等周期；今日「错题数」为当天刷题时最后一次判错的题数；「今日收获」中的待复习与待复习列表同一口径。</text>
    <text class="home-guide-line muted">底部「刷题」Tab 进入科目与单元练习；加入班级请前往「我的」。</text>
  </view>

  <view class="ios-card home-today-card">
    <view class="home-today-head">
      <text class="home-today-title">今日收获</text>
      <text class="home-today-streak">连续打卡 <text class="home-today-streak-n">{{todayDisplay.streak}}</text> 天<text wx:if="{{todayDisplay.streakHint}}" class="muted home-today-streak-hint">{{todayDisplay.streakHint}}</text></text>
    </view>
    <text class="home-today-lead muted">{{todayDisplay.lead}}</text>
    <view class="home-today-stats">
      <view class="home-today-stat">
        <text class="home-today-stat-val">{{todayDisplay.practiced}}</text>
        <text class="home-today-stat-lab">今日答题</text>
      </view>
      <view class="home-today-stat">
        <text class="home-today-stat-val">{{todayDisplay.accuracy}}<text wx:if="{{loggedIn && todayDisplay.accuracy !== '—'}}">%</text></text>
        <text class="home-today-stat-lab">今日正确率</text>
      </view>
      <view class="home-today-stat {{loggedIn ? 'home-today-stat--tap' : ''}}" hover-class="{{loggedIn ? 'home-today-stat-hover' : ''}}" hover-stay-time="70" bindtap="{{loggedIn ? 'goReviewToday' : ''}}">
        <text class="home-today-stat-val home-today-stat-val--warn">{{todayDisplay.reviewDue}}</text>
        <text class="home-today-stat-lab">待复习</text>
      </view>
    </view>
    <text wx:if="{{!loggedIn}}" class="home-guest-foot muted">未登录，暂无数据</text>
  </view>

  <!-- 考试 -->
  <view class="home-dash-card home-dash-card--exam ios-card">
    <view class="home-dash-head">
      <text class="home-dash-title">考试</text>
      <view class="home-dash-link link-tint tap-link" hover-class="link-tint-hover" hover-stay-time="70" bindtap="goExamList">全部</view>
    </view>
    <text class="home-dash-sub muted">班级考试 · 近 120 天</text>

    <block wx:if="{{!loggedIn}}">
      <view class="home-dash-empty muted">登录后查看班级考试；可先浏览考试列表页</view>
    </block>
    <block wx:elif="{{needJoinClass}}">
      <view class="home-dash-empty muted">未加入班级暂无数据</view>
    </block>
    <block wx:else>
      <block wx:if="{{examListLoading}}">
        <view class="home-dash-empty muted">考试信息加载中…</view>
      </block>
      <block wx:elif="{{examListError}}">
        <view class="home-dash-empty muted">{{examListError}}</view>
        <view class="home-dash-retry link-tint tap-link--row" hover-class="link-tint-hover" hover-stay-time="70" bindtap="loadStudentExams">点击重试</view>
      </block>
      <block wx:else>
        <block wx:if="{{examTasks.length}}">
          <view class="home-dash-pill">
            <text class="home-dash-pill-t">待完成</text>
            <text class="home-dash-pill-n">{{examTasks.length}}</text>
            <text class="home-dash-pill-h muted">场进行中</text>
          </view>
          <block wx:for="{{examTasks}}" wx:key="id">
            <view wx:if="{{index < 2}}" class="home-dash-task" hover-class="home-dash-task-hover" hover-stay-time="70" bindtap="goExamTake" data-id="{{item.id}}">
              <view class="home-dash-task-main">
                <text class="home-dash-task-title">{{item.title}}</text>
                <text class="home-dash-task-meta muted">{{item.subject_name}} · {{item.submission_label}}</text>
              </view>
              <text class="home-dash-task-go">进入</text>
            </view>
          </block>
        </block>
        <block wx:if="{{examOverview}}">
          <view wx:if="{{examOverview.total === 0}}" class="home-dash-empty muted">暂无分配给你的班级考试</view>
          <block wx:else>
            <view class="home-dash-spotlight home-dash-spotlight--exam" hover-class="home-dash-spotlight-hover" hover-stay-time="70" bindtap="goExamList">
              <view class="home-dash-spot-cell">
                <text class="home-dash-spot-val">{{examOverview.todo_count}}</text>
                <text class="home-dash-spot-lab">待参加</text>
              </view>
              <view class="home-dash-spot-cell">
                <text class="home-dash-spot-val">{{examOverview.submitted}}</text>
                <text class="home-dash-spot-lab">已交卷</text>
              </view>
            </view>
          </block>
        </block>
      </block>
    </block>
  </view>

  <!-- 刷题 -->
  <view wx:if="{{loggedIn && statsLoading}}" class="home-loading muted">刷题数据加载中…</view>
  <view wx:elif="{{loggedIn && statsError}}" class="ios-card home-err">
    <text class="muted">{{statsError}}</text>
    <view class="home-retry link-tint tap-link--row" hover-class="link-tint-hover" hover-stay-time="70" bindtap="loadHomeSummary">点击重试</view>
  </view>
  <view wx:else class="home-dash-card home-dash-card--quiz ios-card">
    <view class="home-dash-head">
      <text class="home-dash-title">刷题</text>
      <view class="home-dash-link link-tint tap-link" hover-class="link-tint-hover" hover-stay-time="70" bindtap="goQuiz">去刷题</view>
    </view>
    <text class="home-dash-sub muted">个人答题统计；班级排名需加入班级后显示</text>

    <view class="home-practice-tabs">
      <view
        wx:for="{{practiceTabList}}"
        wx:key="key"
        class="home-practice-tab {{practiceTab === item.key ? 'home-practice-tab--on' : ''}}"
        data-key="{{item.key}}"
        hover-class="home-practice-tab-hover"
        hover-stay-time="70"
        bindtap="onPracticeTab"
      >{{item.label}}</view>
    </view>
    <view class="home-practice-grid">
      <view class="home-practice-metric" hover-class="{{loggedIn ? 'home-practice-metric-hover' : ''}}" hover-stay-time="70" bindtap="{{loggedIn ? 'goQuiz' : ''}}">
        <text class="home-practice-metric-val">{{practicePanel.practice_questions}}</text>
        <text class="home-practice-metric-lab">答题数</text>
      </view>
      <view class="home-practice-metric home-practice-metric--warn" hover-class="{{loggedIn ? 'home-practice-metric-hover' : ''}}" hover-stay-time="70" bindtap="{{loggedIn ? 'goWrongOrReviewToday' : ''}}">
        <text class="home-practice-metric-val home-practice-metric-val--warn">{{practicePanel.wrong_count}}</text>
        <text class="home-practice-metric-lab">{{practiceWrongLabel}}</text>
      </view>
      <view class="home-practice-metric home-practice-metric--static">
        <text class="home-practice-metric-val">{{practicePanel.accuracy_pct}}<text wx:if="{{loggedIn && practicePanel.accuracy_pct !== '—'}}">%</text></text>
        <text class="home-practice-metric-lab">正确率</text>
      </view>
      <view class="home-practice-metric home-practice-metric--rank" hover-class="{{loggedIn ? 'home-practice-metric-hover' : ''}}" hover-stay-time="70" bindtap="{{loggedIn ? 'goPracticeClassRank' : ''}}">
        <text class="home-practice-metric-val home-practice-metric-val--rank">{{practicePanel.rank_main}}</text>
        <text class="home-practice-metric-lab">班级排名</text>
        <text class="home-practice-metric-h muted">{{practicePanel.rank_sub}}</text>
      </view>
    </view>
    <text wx:if="{{!loggedIn}}" class="home-guest-foot muted">未登录，暂无数据</text>
    <view wx:elif="{{loggedIn && !practice_periods}}" class="home-dash-empty muted">暂无刷题统计</view>
  </view>
</view>
