<view class="page-wrap home-page">
  <view class="page-hero home-hero">
    <view class="page-hero-accent"></view>
    <view class="page-hero-body">
      <text class="page-hero-date">{{dateText}}</text>
      <text class="page-hero-title">今天练几题？</text>
      <text class="page-hero-lead muted">考试看待办与得分，刷题看今日与巩固</text>
    </view>
  </view>

  <block wx:if="{{!loggedIn}}">
    <view class="ios-card home-guest-stats">
      <text class="home-guest-title muted">登录后查看数据</text>
      <text class="home-guest-desc muted">考试进度、刷题统计与错题本一站式查看</text>
      <view class="btn-primary home-guest-btn" bindtap="goLogin">去登录</view>
    </view>
  </block>

  <block wx:else>
    <!-- 考试 -->
    <view class="home-dash-card home-dash-card--exam ios-card">
      <view class="home-dash-head">
        <text class="home-dash-title">考试</text>
        <text class="home-dash-link link-tint" bindtap="goExamList">全部</text>
      </view>
      <text class="home-dash-sub muted">班级考试 · 近 120 天 · 点区块进列表</text>

      <block wx:if="{{examListLoading}}">
        <view class="home-dash-empty muted">考试信息加载中…</view>
      </block>

      <block wx:elif="{{examListError}}">
        <view class="home-dash-empty muted">{{examListError}}</view>
        <view class="home-dash-retry link-tint" bindtap="loadStudentExams">点击重试</view>
      </block>

      <block wx:else>
        <block wx:if="{{examTasks.length}}">
          <view class="home-dash-pill">
            <text class="home-dash-pill-t">待完成</text>
            <text class="home-dash-pill-n">{{examTasks.length}}</text>
            <text class="home-dash-pill-h muted">场进行中</text>
          </view>
          <block wx:for="{{examTasks}}" wx:key="id">
            <view wx:if="{{index < 2}}" class="home-dash-task" bindtap="goExamTake" data-id="{{item.id}}">
              <view class="home-dash-task-main">
                <text class="home-dash-task-title">{{item.title}}</text>
                <text class="home-dash-task-meta muted">{{item.subject_name}} · {{item.submission_label}}</text>
              </view>
              <text class="home-dash-task-go">进入</text>
            </view>
          </block>
          <view wx:if="{{examTasks.length > 2}}" class="home-dash-more link-tint" bindtap="goExamList">还有 {{examTasks.length - 2}} 场待考…</view>
        </block>

        <block wx:if="{{examOverview}}">
          <view wx:if="{{examOverview.total === 0}}" class="home-dash-empty muted">暂无分配给你的班级考试</view>
          <block wx:else>
            <view class="home-dash-spotlight home-dash-spotlight--exam" bindtap="goExamList">
              <view class="home-dash-spot-cell">
                <text class="home-dash-spot-eyebrow home-dash-spot-eyebrow--exam">优先处理</text>
                <text class="home-dash-spot-val">{{examOverview.todo_count}}</text>
                <text class="home-dash-spot-lab">待参加</text>
                <text class="home-dash-spot-hint muted">含进行中与未开始</text>
              </view>
              <view class="home-dash-spot-divider"></view>
              <view class="home-dash-spot-cell">
                <text class="home-dash-spot-eyebrow home-dash-spot-eyebrow--exam">已完成</text>
                <text class="home-dash-spot-val">{{examOverview.submitted}}</text>
                <text class="home-dash-spot-lab">已交卷</text>
              </view>
            </view>
            <view class="home-dash-score-row" bindtap="goExamList">
              <text class="home-dash-score-label">场均得分（已出分）</text>
              <text class="home-dash-score-val">{{examOverview.avg_score_display}}</text>
            </view>
          </block>
        </block>
      </block>
    </view>

    <!-- 刷题 -->
    <view wx:if="{{statsLoading}}" class="home-loading muted">刷题数据加载中…</view>
    <view wx:elif="{{statsError}}" class="ios-card home-err">
      <text class="muted">{{statsError}}</text>
      <view class="home-retry link-tint" bindtap="loadHomeSummary">点击重试</view>
    </view>
    <view wx:else class="home-dash-card home-dash-card--quiz ios-card">
      <view class="home-dash-head">
        <text class="home-dash-title">刷题</text>
        <text class="home-dash-link link-tint" bindtap="goQuiz">去刷题</text>
      </view>
      <text class="home-dash-sub muted">不含班级正式考试；今日同题计 1 次，本周/月/全部按自然日合计后再相加。正确率为原始判题正确率。排名按答题数×正确率</text>

      <view wx:if="{{!practice_periods}}" class="home-dash-empty muted">暂无刷题统计</view>
      <block wx:else>
        <view class="home-practice-tabs">
          <view
            wx:for="{{practiceTabList}}"
            wx:key="key"
            class="home-practice-tab {{practiceTab === item.key ? 'home-practice-tab--on' : ''}}"
            data-key="{{item.key}}"
            bindtap="onPracticeTab"
          >
            {{item.label}}
          </view>
        </view>
        <view class="home-practice-grid">
          <view class="home-practice-metric" bindtap="goQuiz">
            <text class="home-practice-metric-val">{{practicePanel.practice_questions}}</text>
            <text class="home-practice-metric-lab">答题数</text>
            <text class="home-practice-metric-h muted">今日每题计 1；周/月/全部按日合计</text>
          </view>
          <view class="home-practice-metric home-practice-metric--warn" bindtap="goRecordWrong">
            <text class="home-practice-metric-val home-practice-metric-val--warn">{{practicePanel.wrong_count}}</text>
            <text class="home-practice-metric-lab">错题数</text>
            <text class="home-practice-metric-h muted">今日每题错题计 1；周/月/全部按日合计</text>
          </view>
          <view class="home-practice-metric home-practice-metric--static">
            <text class="home-practice-metric-val">{{practicePanel.accuracy_pct}}%</text>
            <text class="home-practice-metric-lab">正确率</text>
            <text class="home-practice-metric-h muted">按本周期判题次数</text>
          </view>
          <view class="home-practice-metric home-practice-metric--rank" bindtap="goPracticeClassRank">
            <text class="home-practice-metric-val home-practice-metric-val--rank">{{practicePanel.rank_main}}</text>
            <text class="home-practice-metric-lab">班级排名</text>
            <text class="home-practice-metric-h muted">{{practicePanel.rank_sub}}</text>
          </view>
        </view>
        <view class="home-dash-foot muted" bindtap="goQuiz">点答题数或此处进刷题 · 错题数进错题本 · 点班级排名看全班榜</view>
      </block>
    </view>
  </block>
</view>
