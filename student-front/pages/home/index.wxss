.home-page {
  padding-top: 8rpx;
  padding-bottom: 24rpx;
}

.home-browse-tip {
  margin-bottom: 24rpx;
  padding: 24rpx 28rpx;
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.home-browse-tip-text {
  flex: 1;
  font-size: 26rpx;
  line-height: 1.45;
}

.home-browse-login {
  flex-shrink: 0;
  font-size: 28rpx;
}

.home-hero {
  margin-bottom: 28rpx;
}

.home-guide-card {
  padding: 24rpx 28rpx 28rpx;
  margin-bottom: 24rpx;
  border-left: 6rpx solid rgba(0, 122, 255, 0.65);
}

.home-guide-head {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 14rpx;
}

.home-guide-title {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--ios-label);
}

.home-guide-dismiss {
  font-size: 28rpx;
  font-weight: 600;
}

.home-guide-line {
  display: block;
  font-size: 26rpx;
  line-height: 1.45;
  margin-top: 8rpx;
}

.home-today-card {
  padding: 24rpx 28rpx 28rpx;
  margin-bottom: 24rpx;
  border-left: 6rpx solid rgba(52, 199, 89, 0.75);
}

.home-today-head {
  display: flex;
  flex-direction: row;
  align-items: baseline;
  justify-content: space-between;
  margin-bottom: 10rpx;
}

.home-today-title {
  font-size: 32rpx;
  font-weight: 800;
  color: var(--ios-label);
}

.home-today-streak {
  font-size: 24rpx;
  color: var(--ios-secondary);
}

.home-today-streak-n {
  font-weight: 700;
  color: var(--ios-tint);
}

.home-today-lead {
  display: block;
  font-size: 26rpx;
  line-height: 1.45;
  margin-bottom: 20rpx;
}

.home-today-stats {
  display: flex;
  flex-direction: row;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 20rpx;
}

.home-today-stat {
  flex: 1;
  min-width: 0;
  text-align: center;
  padding: 16rpx 8rpx;
  border-radius: 14rpx;
  background: rgba(60, 60, 67, 0.06);
}

.home-today-stat--tap {
  background: rgba(194, 65, 12, 0.08);
}

.home-today-stat-hover {
  opacity: 0.82;
}

.home-today-stat-val {
  display: block;
  font-size: 36rpx;
  font-weight: 800;
  color: var(--ios-label);
}

.home-today-stat-val--warn {
  color: #c2410c;
}

.home-today-stat-lab {
  display: block;
  margin-top: 6rpx;
  font-size: 22rpx;
  color: var(--ios-secondary);
}

/* —— 分区卡片：考试 / 刷题 —— */
.home-dash-card {
  padding: 28rpx 24rpx 32rpx;
  margin-bottom: 24rpx;
  box-sizing: border-box;
}

.home-dash-card--exam {
  border-top: 6rpx solid rgba(124, 92, 255, 0.85);
}

.home-dash-card--quiz {
  border-top: 6rpx solid rgba(0, 122, 255, 0.85);
}

.home-dash-head {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 8rpx;
}

.home-dash-title {
  font-size: 34rpx;
  font-weight: 800;
  color: var(--ios-label);
  letter-spacing: -0.02em;
}

.home-dash-link {
  font-size: 28rpx;
  font-weight: 600;
}

.home-dash-sub {
  display: block;
  font-size: 24rpx;
  margin-bottom: 24rpx;
}

.home-dash-empty {
  text-align: center;
  padding: 24rpx 12rpx;
  font-size: 26rpx;
  line-height: 1.45;
}

.home-dash-retry {
  text-align: center;
  font-size: 28rpx;
  font-weight: 600;
  padding-bottom: 8rpx;
}

.home-dash-pill {
  display: flex;
  flex-direction: row;
  align-items: baseline;
  flex-wrap: wrap;
  gap: 10rpx 16rpx;
  padding: 20rpx 22rpx;
  margin-bottom: 16rpx;
  border-radius: 16rpx;
  background: linear-gradient(135deg, rgba(255, 149, 0, 0.12) 0%, rgba(255, 59, 48, 0.06) 100%);
  border: 1rpx solid rgba(255, 149, 0, 0.35);
}

.home-dash-pill-t {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--ios-label);
}

.home-dash-pill-n {
  font-size: 40rpx;
  font-weight: 800;
  color: #c2410c;
}

.home-dash-pill-h {
  font-size: 24rpx;
}

.home-dash-task {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  padding: 22rpx 0;
  border-top: 1rpx solid var(--ios-separator);
}

.home-dash-task-hover {
  opacity: 0.88;
}

.home-dash-task-main {
  flex: 1;
  min-width: 0;
  padding-right: 16rpx;
}

.home-dash-task-title {
  display: block;
  font-size: 30rpx;
  font-weight: 600;
  color: var(--ios-label);
  line-height: 1.35;
}

.home-dash-task-meta {
  display: block;
  margin-top: 6rpx;
  font-size: 24rpx;
}

.home-dash-task-go {
  flex-shrink: 0;
  font-size: 28rpx;
  font-weight: 600;
  color: var(--ios-tint);
}

.home-dash-more {
  text-align: center;
  font-size: 26rpx;
  font-weight: 600;
  padding: 16rpx 0 4rpx;
}

/* 主指标：双栏聚光灯，数字最大、标签次之 */
.home-dash-spotlight {
  display: flex;
  flex-direction: row;
  align-items: stretch;
  padding: 28rpx 20rpx;
  margin-bottom: 16rpx;
  border-radius: 20rpx;
  box-sizing: border-box;
}

.home-dash-spotlight-hover {
  opacity: 0.92;
}

.home-dash-spotlight--exam {
  background: linear-gradient(160deg, rgba(124, 92, 255, 0.14) 0%, rgba(124, 92, 255, 0.05) 100%);
  border: 2rpx solid rgba(124, 92, 255, 0.22);
}

.home-dash-spot-cell {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  justify-content: center;
}

.home-dash-spot-eyebrow {
  display: block;
  font-size: 22rpx;
  font-weight: 700;
  letter-spacing: 0.06em;
  line-height: 1.2;
  margin-bottom: 10rpx;
}

.home-dash-spot-eyebrow--exam {
  color: #5b21b6;
}

.home-dash-spot-eyebrow--quiz {
  color: #0066cc;
}

.home-dash-spot-val {
  display: block;
  font-size: 56rpx;
  font-weight: 800;
  color: var(--ios-label);
  letter-spacing: -0.04em;
  line-height: 1.05;
}

.home-dash-spot-val--quiz {
  color: #0051d5;
}

.home-dash-spot-lab {
  display: block;
  margin-top: 10rpx;
  font-size: 28rpx;
  font-weight: 700;
  color: var(--ios-label);
  letter-spacing: -0.02em;
}

.home-dash-spot-hint {
  display: block;
  margin-top: 8rpx;
  font-size: 22rpx;
  line-height: 1.35;
}

.home-dash-spot-divider {
  width: 2rpx;
  align-self: stretch;
  margin: 8rpx 0;
  background: rgba(60, 60, 67, 0.12);
  flex-shrink: 0;
}

/* 考试：场均得分单独一行，与「练习数据」区分 */
.home-dash-score-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  padding: 22rpx 24rpx;
  border-radius: 16rpx;
  background: rgba(124, 92, 255, 0.08);
  border: 1rpx solid rgba(124, 92, 255, 0.18);
  box-sizing: border-box;
}

.home-dash-score-row-hover {
  opacity: 0.9;
}

.home-dash-score-label {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--ios-label);
  flex: 1;
  min-width: 0;
  padding-right: 16rpx;
}

.home-dash-score-val {
  font-size: 40rpx;
  font-weight: 800;
  color: #5b21b6;
  letter-spacing: -0.02em;
  flex-shrink: 0;
}

/* 刷题：次要指标横条，错题列视觉加重 */
.home-dash-strip {
  display: flex;
  flex-direction: row;
  align-items: stretch;
  padding: 20rpx 16rpx;
  margin-bottom: 4rpx;
  border-radius: 16rpx;
  background: rgba(60, 60, 67, 0.06);
  box-sizing: border-box;
}

.home-dash-strip-item {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  text-align: center;
  padding: 8rpx 4rpx;
}

.home-dash-strip-item-hover {
  opacity: 0.88;
}

.home-dash-strip-val {
  font-size: 36rpx;
  font-weight: 800;
  color: var(--ios-label);
  letter-spacing: -0.03em;
  line-height: 1.1;
}

.home-dash-strip-val--warn {
  color: #c41e16;
}

.home-dash-strip-lab {
  margin-top: 8rpx;
  font-size: 22rpx;
  font-weight: 600;
  color: var(--ios-secondary);
  line-height: 1.3;
}

.home-dash-strip-item--warn .home-dash-strip-lab {
  color: #b91c1c;
}

.home-dash-strip-gap {
  width: 2rpx;
  align-self: stretch;
  margin: 4rpx 0;
  background: var(--ios-separator);
  flex-shrink: 0;
}

/* 刷题：周期 Tab + 四宫格指标 */
.home-practice-tabs {
  display: flex;
  flex-direction: row;
  flex-wrap: nowrap;
  gap: 12rpx;
  margin-bottom: 20rpx;
}

.home-practice-tab {
  flex: 1;
  text-align: center;
  padding: 14rpx 8rpx;
  font-size: 26rpx;
  font-weight: 600;
  color: var(--ios-secondary);
  background: rgba(60, 60, 67, 0.06);
  border-radius: 12rpx;
  border: 2rpx solid transparent;
  box-sizing: border-box;
}

.home-practice-tab-hover {
  opacity: 0.88;
}

.home-practice-tab--on {
  color: #0051d5;
  background: rgba(0, 122, 255, 0.1);
  border-color: rgba(0, 122, 255, 0.35);
}

.home-practice-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
}

.home-practice-metric {
  padding: 22rpx 18rpx 24rpx;
  border-radius: 16rpx;
  background: rgba(60, 60, 67, 0.06);
  border: 2rpx solid transparent;
  box-sizing: border-box;
  text-align: center;
}

.home-practice-metric-hover {
  opacity: 0.9;
}

.home-practice-metric--warn {
  background: rgba(255, 59, 48, 0.08);
  border-color: rgba(255, 59, 48, 0.2);
}

.home-practice-metric--rank {
  background: rgba(0, 122, 255, 0.06);
  border-color: rgba(0, 122, 255, 0.18);
}

/* 静态指标格：按下不改变透明度，避免「死区」误触反馈 */
.home-practice-metric-static-hover {
  opacity: 1;
}

.home-practice-metric-val {
  display: block;
  font-size: 44rpx;
  font-weight: 800;
  color: var(--ios-label);
  letter-spacing: -0.03em;
  line-height: 1.1;
}

.home-practice-metric-val--warn {
  color: #c41e16;
}

.home-practice-metric-val--rank {
  font-size: 38rpx;
  color: #0051d5;
}

.home-practice-metric-lab {
  display: block;
  margin-top: 10rpx;
  font-size: 26rpx;
  font-weight: 700;
  color: var(--ios-label);
}

.home-practice-metric-h {
  display: block;
  margin-top: 8rpx;
  font-size: 22rpx;
  line-height: 1.35;
}

.home-dash-foot {
  margin-top: 20rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid var(--ios-separator);
  font-size: 24rpx;
  text-align: center;
}

.home-dash-foot-num {
  font-weight: 700;
  color: var(--ios-tint);
}

.home-guest-stats {
  padding: 36rpx 28rpx;
  margin-bottom: 24rpx;
  text-align: center;
}

.home-guest-title {
  display: block;
  font-size: 30rpx;
  font-weight: 600;
  margin-bottom: 12rpx;
}

.home-guest-desc {
  display: block;
  font-size: 26rpx;
  line-height: 1.45;
  margin-bottom: 28rpx;
}

.home-guest-btn {
  margin: 0 auto;
  max-width: 420rpx;
}

.home-guest-foot {
  display: block;
  margin-top: 20rpx;
  font-size: 22rpx;
  line-height: 1.45;
  text-align: center;
}

.home-today-streak-hint {
  font-size: 22rpx;
  font-weight: 400;
  margin-left: 4rpx;
}

.home-loading {
  text-align: center;
  padding: 32rpx;
  font-size: 28rpx;
  margin-bottom: 16rpx;
}

.home-err {
  padding: 28rpx;
  text-align: center;
  margin-bottom: 24rpx;
}

.home-retry {
  margin-top: 16rpx;
  font-size: 28rpx;
  font-weight: 600;
}
