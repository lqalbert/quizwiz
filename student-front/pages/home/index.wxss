.home-page {
  padding-top: 8rpx;
}

.hero-block {
  margin-bottom: 40rpx;
}

.hero-date {
  display: block;
  font-size: 24rpx;
  font-weight: 500;
  color: var(--ios-secondary);
  margin-bottom: 12rpx;
}

.hero-title {
  display: block;
  font-size: 56rpx;
  font-weight: 700;
  letter-spacing: -0.03em;
  line-height: 1.12;
  color: var(--ios-label);
}

.hero-sub {
  display: block;
  margin-top: 16rpx;
  font-size: 28rpx;
  line-height: 1.35;
}

.hero-cta {
  margin-bottom: 8rpx;
}

.hero-cta-inner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 36rpx 28rpx;
}

.hero-cta-text {
  flex: 1;
  min-width: 0;
}

.hero-cta-label {
  display: block;
  font-size: 34rpx;
  font-weight: 600;
  letter-spacing: -0.02em;
}

.hero-cta-desc {
  display: block;
  margin-top: 10rpx;
  font-size: 26rpx;
  line-height: 1.35;
}

.hero-cta-icon-wrap {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: rgba(0, 122, 255, 0.12);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-left: 24rpx;
}

.hero-cta-icon {
  font-size: 40rpx;
  font-weight: 300;
  color: var(--ios-tint);
  line-height: 1;
}

.hero-cta:active {
  opacity: 0.92;
  transform: scale(0.99);
}
