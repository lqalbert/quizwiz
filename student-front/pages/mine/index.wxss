.mine-page {
  padding-top: 8rpx;
}

.guest-title {
  display: block;
  font-size: 30rpx;
  color: var(--ios-secondary);
  line-height: 1.45;
  padding: 8rpx 0 28rpx;
}

.guest-desc {
  display: block;
  margin-bottom: 24rpx;
  font-size: 26rpx;
  line-height: 1.45;
}

.guest-login {
  margin-top: 0;
}

.profile-card {
  padding: 36rpx 28rpx;
  margin-bottom: 8rpx;
}

.profile-row {
  display: flex;
  align-items: center;
}

.avatar-ring {
  padding: 4rpx;
  border-radius: 50%;
  background: linear-gradient(145deg, rgba(0, 122, 255, 0.35), rgba(88, 86, 214, 0.25));
}

.avatar-choose-btn {
  padding: 0;
  margin: 0;
  border: none;
  background: transparent;
  line-height: 1;
  display: block;
}

.avatar-choose-btn::after {
  border: none;
}

.name-row {
  display: flex;
  align-items: baseline;
  gap: 12rpx;
}

.name-row-hover {
  opacity: 0.75;
}

.name-edit-hint {
  font-size: 24rpx;
  font-weight: 400;
}

.avatar {
  width: 112rpx;
  height: 112rpx;
  border-radius: 50%;
  background: linear-gradient(180deg, #f7f7f8 0%, #e8e8ed 100%);
  color: var(--ios-label);
  font-size: 40rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
}

.avatar-img {
  width: 112rpx;
  height: 112rpx;
  border-radius: 50%;
  display: block;
  background: #e8e8ed;
}

.profile-text {
  flex: 1;
  margin-left: 28rpx;
  min-width: 0;
}

.name {
  display: block;
  font-size: 36rpx;
  font-weight: 700;
  letter-spacing: -0.02em;
}

.subline {
  display: block;
  margin-top: 8rpx;
  font-size: 26rpx;
  line-height: 1.35;
}

.class-row {
  padding: 28rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}

.class-row + .class-row {
  border-top: 1rpx solid var(--ios-separator);
}

.class-row-text {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.class-name {
  font-size: 32rpx;
  font-weight: 500;
}

.leave-pending-label {
  font-size: 24rpx;
  flex-shrink: 0;
}

.leave-pending-tip {
  padding: 24rpx 28rpx;
  margin-bottom: 8rpx;
}

.leave-pending-tip-text {
  font-size: 26rpx;
  color: var(--ios-secondary);
  line-height: 1.45;
}

.empty-class-card {
  padding: 32rpx 28rpx;
}

.empty-class {
  font-size: 28rpx;
  line-height: 1.45;
}

.name-edit-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 1000;
  background: rgba(0, 0, 0, 0.45);
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 48rpx;
  box-sizing: border-box;
}

.name-edit-dialog {
  width: 100%;
  max-width: 620rpx;
  background: var(--ios-fill);
  border-radius: var(--ios-radius-card);
  box-shadow: 0 16rpx 64rpx rgba(0, 0, 0, 0.18);
  padding: 36rpx 32rpx 32rpx;
  box-sizing: border-box;
}

.name-edit-dialog-title {
  display: block;
  font-size: 34rpx;
  font-weight: 700;
  color: var(--ios-label);
  margin-bottom: 12rpx;
}

.name-edit-hint {
  display: block;
  font-size: 24rpx;
  margin-bottom: 20rpx;
  line-height: 1.4;
}

.name-edit-input {
  display: block;
  width: 100%;
  box-sizing: border-box;
  min-height: 96rpx;
  padding: 22rpx 24rpx;
  font-size: 32rpx;
  line-height: 1.35;
  border-radius: 16rpx;
  background: rgba(60, 60, 67, 0.06);
  color: var(--ios-label);
}

.ios-cell-title.plain {
  font-weight: 400;
}

.cell-right {
  display: flex;
  align-items: center;
}

.extra {
  font-size: 26rpx;
  margin-right: 8rpx;
}

.logout-btn {
  margin-top: 48rpx;
  height: 96rpx;
  line-height: 96rpx;
  border-radius: var(--ios-radius-btn);
  background: var(--ios-fill);
  color: var(--ios-red);
  font-size: 30rpx;
  font-weight: 600;
  border: none;
  box-shadow: var(--ios-shadow);
}

.logout-btn::after {
  border: none;
}

.logout-btn-hover {
  opacity: 0.85;
}

.ph {
  color: rgba(60, 60, 67, 0.48);
}
