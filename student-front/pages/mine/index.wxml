<view class="page-wrap mine-page">
  <join-class-modal
    visible="{{joinModalVisible}}"
    mode="{{joinModalMode}}"
    invite-input="{{joinInviteInput}}"
    real-name-input="{{joinRealNameInput}}"
    submitting="{{joinSubmitting}}"
    closable="{{true}}"
    title-form="加入班级"
    lead-form="请填写与学校登记一致的真实姓名及班级邀请码，便于老师在后台识别你。"
    bind:close="onCloseJoinModal"
    bind:inviteinput="onJoinInviteInput"
    bind:realnameinput="onJoinRealNameInput"
    bind:submit="onSubmitJoinClass"
    bind:refresh="onRefreshJoinPending"
  />

  <block wx:if="{{!loggedIn}}">
    <view class="ios-card profile-card">
      <text class="guest-title">浏览模式</text>
      <text class="guest-desc muted">可浏览各功能页面；登录后同步个人数据，入班请在本页「加入班级」</text>
      <view class="btn-primary guest-login" hover-class="btn-primary-hover" hover-stay-time="70" bindtap="goLogin">去登录</view>
    </view>
  </block>

  <block wx:else>
    <view class="ios-card profile-card">
      <view class="profile-row">
        <view class="avatar-ring">
          <button class="avatar-choose-btn" open-type="chooseAvatar" bindchooseavatar="onChooseAvatar">
            <image wx:if="{{wxAvatarUrl}}" class="avatar-img" src="{{wxAvatarUrl}}" mode="aspectFill" />
            <view wx:else class="avatar">{{avatarLetter}}</view>
          </button>
        </view>
        <view class="profile-text">
          <view class="name-row" hover-class="name-row-hover" hover-stay-time="70" bindtap="onTapEditNickname">
            <text class="name">{{wxNickname}}</text>
            <text class="name-edit-hint muted">修改</text>
          </view>
          <text class="subline muted" wx:if="{{showWxProfileHint}}">点头像选微信头像；点昵称可修改</text>
          <text class="subline muted" wx:if="{{needJoinClass}}">尚未加入班级，班级相关数据暂无</text>
        </view>
      </view>
    </view>

    <view wx:if="{{leavePendingCount > 0}}" class="ios-card leave-pending-tip">
      <text class="leave-pending-tip-text">你有 {{leavePendingCount}} 条退出班级申请正在等待教师审核。</text>
    </view>

    <text class="section-label">我的班级</text>
    <view class="ios-card" wx:if="{{classes.length}}">
      <view wx:for="{{classes}}" wx:key="id" class="class-row">
        <view class="class-row-text">
          <text class="class-name">{{item.name}}</text>
        </view>
        <text wx:if="{{item.leave_pending}}" class="leave-pending-label muted">退出审核中</text>
      </view>
    </view>
    <view class="ios-card empty-class-card" wx:else>
      <text class="empty-class muted">未加入班级暂无数据</text>
    </view>

    <text class="section-label">资料</text>
    <view class="ios-card">
      <view class="ios-cell" hover-class="ios-cell-hover" hover-stay-time="70" bindtap="onTapEditName">
        <view class="ios-cell-main">
          <text class="ios-cell-sub">真实姓名</text>
          <text class="ios-cell-title">{{realDisplayName}}</text>
        </view>
        <text class="ios-cell-chevron">›</text>
      </view>
    </view>
  </block>

  <text class="section-label">功能</text>
  <view class="ios-card">
    <block wx:for="{{menus}}" wx:key="title">
      <view
        wx:if="{{item.action !== 'join_class' || loggedIn}}"
        class="ios-cell"
        hover-class="ios-cell-hover"
        hover-stay-time="70"
        bindtap="onMenu"
        data-title="{{item.title}}"
        data-path="{{item.path}}"
        data-action="{{item.action}}"
      >
        <text class="ios-cell-title plain">{{item.title}}</text>
        <view class="cell-right">
          <text wx:if="{{item.extra}}" class="extra muted">{{item.extra}}</text>
          <text class="ios-cell-chevron">›</text>
        </view>
      </view>
    </block>
  </view>

  <button wx:if="{{loggedIn}}" class="logout-btn" hover-class="logout-btn-hover" hover-stay-time="70" bindtap="logout">退出登录</button>

  <view wx:if="{{loggedIn && nickEditVisible}}" class="name-edit-mask" catchtouchmove="noop" bindtap="cancelNickEdit">
    <view class="name-edit-dialog" catchtap="noop">
      <text class="name-edit-dialog-title">修改昵称</text>
      <input class="name-edit-input" type="nickname" value="{{nickDraft}}" maxlength="32" placeholder="微信昵称" placeholder-class="ph" bindinput="onNickDraftInput" />
      <view class="ui-modal-actions">
        <view class="ui-modal-btn ui-modal-btn--cancel" hover-class="ui-modal-btn-hover" hover-stay-time="70" bindtap="cancelNickEdit">取消</view>
        <view class="ui-modal-btn ui-modal-btn--ok" hover-class="ui-modal-btn-hover" hover-stay-time="70" bindtap="saveNickEdit">保存</view>
      </view>
    </view>
  </view>

  <view wx:if="{{loggedIn && nameEditVisible}}" class="name-edit-mask" catchtouchmove="noop" bindtap="cancelNameEdit">
    <view class="name-edit-dialog" catchtap="noop">
      <text class="name-edit-dialog-title">修改真实姓名</text>
      <input class="name-edit-input" type="text" value="{{nameDraft}}" maxlength="64" placeholder="请输入真实姓名" placeholder-class="ph" bindinput="onNameDraftInput" />
      <view class="ui-modal-actions">
        <view class="ui-modal-btn ui-modal-btn--cancel" hover-class="ui-modal-btn-hover" hover-stay-time="70" bindtap="cancelNameEdit">取消</view>
        <view class="ui-modal-btn ui-modal-btn--ok" hover-class="ui-modal-btn-hover" hover-stay-time="70" bindtap="saveNameEdit">保存</view>
      </view>
    </view>
  </view>
</view>
