<view class="page-wrap mine-page">
  <block wx:if="{{!loggedIn}}">
    <view class="ios-card profile-card">
      <text class="guest-title">登录后查看班级与练习记录</text>
      <view class="btn-primary guest-login" hover-class="btn-primary-hover" hover-stay-time="70" bindtap="goLogin">去登录</view>
    </view>
  </block>

  <block wx:else>
    <view class="ios-card profile-card">
      <view class="profile-row">
        <view class="avatar-ring" hover-class="avatar-ring-hover" hover-stay-time="70" bindtap="onTapSyncWechatProfile">
          <image wx:if="{{wxAvatarUrl}}" class="avatar-img" src="{{wxAvatarUrl}}" mode="aspectFill" />
          <view wx:else class="avatar">{{avatarLetter}}</view>
        </view>
        <view class="profile-text">
          <text class="name">{{wxNickname}}</text>
          <text class="subline muted" wx:if="{{showWxProfileHint}}">轻点头像，使用微信提供的头像与昵称填写能力完成设置</text>
          <text class="subline muted" wx:if="{{needJoinClass}}">须加入班级后方可使用刷题、考试与做题记录</text>
        </view>
      </view>
    </view>

    <view wx:if="{{leavePendingCount > 0}}" class="ios-card leave-pending-tip">
      <text class="leave-pending-tip-text">你有 {{leavePendingCount}} 条退出班级申请正在等待教师审核；通过前仍在原班级，功能可正常使用。</text>
    </view>

    <text class="section-label">我的班级</text>
    <view class="ios-card" wx:if="{{classes.length}}">
      <view wx:for="{{classes}}" wx:key="id" class="class-row">
        <view class="class-row-text">
          <text class="class-name">{{item.name}}</text>
        </view>
        <text wx:if="{{item.leave_pending}}" class="leave-pending-label muted">退出审核中</text>
      </view>
    </view>
    <view class="ios-card empty-class-card" wx:elif="{{needJoinClass}}">
      <text class="empty-class muted">加入班级后，将在此显示你的班级（入班请在登录页完成）</text>
    </view>
    <view class="ios-card empty-class-card" wx:else>
      <text class="empty-class muted">暂无班级（入班请在登录页完成）</text>
    </view>

    <text class="section-label">资料</text>
    <view class="ios-card">
      <view class="ios-cell" hover-class="ios-cell-hover" hover-stay-time="70" bindtap="onTapEditName">
        <view class="ios-cell-main">
          <text class="ios-cell-sub">真实姓名</text>
          <text class="ios-cell-title">{{realDisplayName}}</text>
        </view>
        <text class="ios-cell-chevron">›</text>
      </view>
    </view>
  </block>

  <text class="section-label">功能</text>
  <view class="ios-card">
    <block wx:for="{{menus}}" wx:key="title">
      <view
        class="ios-cell"
        hover-class="ios-cell-hover"
        hover-stay-time="70"
        bindtap="onMenu"
        data-title="{{item.title}}"
        data-path="{{item.path}}"
        data-action="{{item.action}}"
      >
        <text class="ios-cell-title plain">{{item.title}}</text>
        <view class="cell-right">
          <text wx:if="{{item.extra}}" class="extra muted">{{item.extra}}</text>
          <text class="ios-cell-chevron">›</text>
        </view>
      </view>
    </block>
  </view>

  <block wx:if="{{mineShowOther}}">
    <text class="section-label">其他</text>
    <view class="ios-card">
      <view class="ios-cell" hover-class="ios-cell-hover" hover-stay-time="70" bindtap="onPlaceholder" data-title="通知">
        <text class="ios-cell-title plain">通知</text>
        <text class="ios-cell-chevron">›</text>
      </view>
      <view class="ios-cell" hover-class="ios-cell-hover" hover-stay-time="70" bindtap="onPlaceholder" data-title="关于">
        <text class="ios-cell-title plain">关于</text>
        <text class="ios-cell-chevron">›</text>
      </view>
    </view>
  </block>

  <button wx:if="{{loggedIn}}" class="logout-btn" hover-class="logout-btn-hover" hover-stay-time="70" bindtap="logout">退出登录</button>

  <!-- 微信头像昵称：chooseAvatar + nickname（替代 getUserProfile） -->
  <view
    wx:if="{{loggedIn && wxProfileVisible}}"
    class="name-edit-mask"
    catchtouchmove="noop"
    bindtap="cancelWxProfile"
  >
    <view class="name-edit-dialog wx-profile-dialog" catchtap="noop">
      <text class="name-edit-dialog-title">设置头像与昵称</text>
      <text class="name-edit-hint muted">微信已不再开放一键读取真实头像与昵称，请使用下方能力填写；头像将保存到服务器以便长期显示。</text>
      <view class="wx-profile-avatar-row">
        <button
          class="wx-choose-avatar-btn"
          open-type="chooseAvatar"
          bindchooseavatar="onWxChooseAvatar"
          disabled="{{profileAvatarUploading}}"
        >
          {{profileAvatarUploading ? '上传中…' : '选择头像'}}
        </button>
      </view>
      <text class="wx-profile-field-label muted">昵称（将展示在「我的」顶部）</text>
      <input
        class="name-edit-input wx-nickname-input"
        type="nickname"
        value="{{profileNickDraft}}"
        maxlength="32"
        placeholder="点击输入或选用微信昵称"
        placeholder-class="ph"
        adjust-position="{{true}}"
        bindinput="onProfileNickInput"
      />
      <view class="ui-modal-actions">
        <view class="ui-modal-btn ui-modal-btn--cancel" hover-class="ui-modal-btn-hover" hover-stay-time="70" bindtap="cancelWxProfile">取消</view>
        <view class="ui-modal-btn ui-modal-btn--ok" hover-class="ui-modal-btn-hover" hover-stay-time="70" bindtap="confirmWxProfile">完成</view>
      </view>
    </view>
  </view>

  <!-- 姓名编辑：固定遮罩 + 居中弹层，避免内嵌卡片 + overflow 导致输入框畸形 -->
  <view
    wx:if="{{loggedIn && nameEditVisible}}"
    class="name-edit-mask"
    catchtouchmove="noop"
    bindtap="cancelNameEdit"
  >
    <view class="name-edit-dialog" catchtap="noop">
      <text class="name-edit-dialog-title">修改真实姓名</text>
      <text class="name-edit-hint muted">老师端将按此姓名展示</text>
      <input
        class="name-edit-input"
        type="text"
        value="{{nameDraft}}"
        maxlength="64"
        placeholder="请输入真实姓名"
        placeholder-class="ph"
        adjust-position="{{true}}"
        confirm-type="done"
        bindinput="onNameDraftInput"
      />
      <view class="ui-modal-actions">
        <view class="ui-modal-btn ui-modal-btn--cancel" hover-class="ui-modal-btn-hover" hover-stay-time="70" bindtap="cancelNameEdit">取消</view>
        <view class="ui-modal-btn ui-modal-btn--ok" hover-class="ui-modal-btn-hover" hover-stay-time="70" bindtap="saveNameEdit">保存</view>
      </view>
    </view>
  </view>
</view>
