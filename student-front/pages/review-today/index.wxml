<view class="page-wrap review-today-root">
  <view class="review-today-hero">
    <text class="h2">今日待复习</text>
  </view>

  <view wx:if="{{loading && !questions.length}}" class="muted">加载中…</view>
  <view wx:elif="{{err && !questions.length}}" class="ios-card" style="padding:32rpx;">
    <text class="muted">{{err}}</text>
    <view
      class="ui-btn-secondary"
      style="margin-top:24rpx;text-align:center;"
      hover-class="ui-btn-secondary-hover"
      hover-stay-time="70"
      bindtap="loadList"
    >{{needLogin ? '去登录' : '重试'}}</view>
  </view>
  <block wx:else>
    <view class="review-today-pill">共 {{count}} 题</view>
    <view class="review-today-actions">
      <view class="btn-primary" hover-class="btn-primary-hover" hover-stay-time="70" bindtap="startReviewAll" wx:if="{{count > 0}}">开始复习全部</view>
    </view>
    <view wx:if="{{count === 0 && !loading}}" class="ios-card review-empty">
      <text class="review-empty-title">暂无待复习错题</text>
      <text class="muted review-empty-desc">说明当前没有到期的错题，或错题本里已清空。去刷题积累错题后，系统会按节奏提醒你复习。</text>
      <view class="review-empty-actions">
        <view class="ui-btn-secondary review-empty-btn" bindtap="goWrongBook">错题本</view>
        <view class="btn-primary review-empty-btn" bindtap="goBrowseQuiz">去刷题</view>
      </view>
    </view>
    <view wx:elif="{{questions.length}}" class="ios-card review-list-card">
      <block wx:for="{{questions}}" wx:for-index="idx" wx:key="question_id">
        <view class="review-item" hover-class="review-item-hover" hover-stay-time="70" bindtap="startOne" data-id="{{item.question_id}}">
          <view class="record-stem-row">
            <text class="record-seq">{{idx + 1}}.</text>
            <text class="review-item-stem">{{item.stem_display}}</text>
          </view>
          <view wx:if="{{item.options.length}}" class="record-options">
            <view wx:for="{{item.options}}" wx:for-item="opt" wx:for-index="optIdx" wx:key="optIdx" class="record-opt-row">
              <text class="record-opt-k">{{opt.option_key}}.</text>
              <text class="record-opt-t">{{opt.option_text}}</text>
            </view>
          </view>
          <text class="review-item-meta">{{item.question_type_text}} · 复习日 {{item.next_label}}</text>
          <text wx:if="{{item.last_wrong_label}}" class="review-item-meta muted">{{item.last_wrong_label}}</text>
        </view>
      </block>
      <view wx:if="{{listLoadingMore}}" class="load-more-wrap">
        <text class="muted load-more-text">加载更多…</text>
      </view>
      <view wx:elif="{{!hasMore && questions.length}}" class="load-more-wrap">
        <text class="muted load-more-text">已加载全部</text>
      </view>
    </view>
  </block>
</view>
