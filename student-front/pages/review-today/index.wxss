.page-wrap.review-today-root {
  padding-bottom: constant(safe-area-inset-bottom);
  padding-bottom: env(safe-area-inset-bottom);
}

.review-today-hero {
  margin-bottom: 24rpx;
}

.review-today-actions {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  margin-bottom: 24rpx;
}

.review-today-btn-row {
  display: flex;
  flex-direction: row;
  gap: 20rpx;
}

.review-today-pill {
  font-size: 26rpx;
  color: var(--ios-secondary);
  margin-bottom: 16rpx;
}

.review-item {
  padding: 28rpx 0;
  border-bottom: 1rpx solid var(--ios-separator);
}

.review-item:last-child {
  border-bottom: none;
}

.review-item-stem {
  font-size: 30rpx;
  line-height: 1.45;
  color: var(--ios-label);
}

.review-item-meta {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: var(--ios-secondary);
}

.review-empty {
  padding: 48rpx 24rpx;
  text-align: center;
  font-size: 28rpx;
  color: var(--ios-secondary);
}
