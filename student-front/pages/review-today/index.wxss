.page-wrap.review-today-root {
  padding-bottom: constant(safe-area-inset-bottom);
  padding-bottom: env(safe-area-inset-bottom);
}

.review-today-hero {
  margin-bottom: 24rpx;
}

.review-today-actions {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  margin-bottom: 24rpx;
}

.review-today-pill {
  font-size: 26rpx;
  color: var(--ios-secondary);
  margin-bottom: 16rpx;
}

.review-item {
  padding: 28rpx 0;
  border-bottom: 1rpx solid var(--ios-separator);
}

.review-item:last-child {
  border-bottom: none;
}

.review-item-hover {
  background: rgba(0, 0, 0, 0.03);
}

.review-item-stem {
  font-size: 30rpx;
  line-height: 1.45;
  color: var(--ios-label);
}

.review-item-meta {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: var(--ios-secondary);
}

.review-empty {
  padding: 36rpx 28rpx 40rpx;
}

.review-empty-title {
  display: block;
  font-size: 30rpx;
  font-weight: 600;
  margin-bottom: 12rpx;
  color: var(--ios-label);
}

.review-empty-desc {
  display: block;
  font-size: 26rpx;
  line-height: 1.45;
}

.review-empty-actions {
  display: flex;
  flex-direction: row;
  gap: 20rpx;
  margin-top: 28rpx;
}

.review-empty-btn {
  flex: 1;
  text-align: center;
  box-sizing: border-box;
}
