<view class="page-wrap done-root quiz-root">
  <join-class-modal
    visible="{{joinModalVisible}}"
    mode="{{joinModalMode}}"
    invite-input="{{joinInviteInput}}"
    real-name-input="{{joinRealNameInput}}"
    submitting="{{joinSubmitting}}"
    closable="{{true}}"
    title-form="加入班级"
    lead-form="请填写与学校登记一致的真实姓名及班级邀请码，便于老师在后台识别你。"
    bind:close="onCloseJoinModal"
    bind:inviteinput="onJoinInviteInput"
    bind:realnameinput="onJoinRealNameInput"
    bind:submit="onSubmitJoinClass"
    bind:refresh="onRefreshJoinPending"
  />

  <block wx:if="{{step === 'catalog'}}">
    <view class="page-hero record-catalog-hero page-hero--catalog-root">
      <view class="page-hero-accent"></view>
      <view class="page-hero-body">
        <text class="page-hero-title">已做题</text>
        <text class="page-hero-lead muted">选择科目与单元</text>
      </view>
    </view>
    <view class="catalog-wrap">
      <scroll-view scroll-y class="catalog-left" enhanced="{{true}}" show-scrollbar="{{false}}">
        <view
          wx:for="{{subjects}}"
          wx:key="id"
          class="unit-tab {{subjectId == item.id ? 'unit-tab-on' : ''}}"
          hover-class="unit-tab-hover"
          hover-stay-time="70"
          bindtap="onPickSubjectLeft"
          data-id="{{item.id}}"
        >
          {{item.name}}
        </view>
      </scroll-view>
      <scroll-view scroll-y class="catalog-right" enhanced="{{true}}" show-scrollbar="{{false}}">
        <view wx:if="{{!units.length}}" class="ios-card record-catalog-empty">
          <text class="record-empty-title">该科目下暂无知识单元</text>
          <text class="muted">可换一个科目，或稍后再试。</text>
        </view>
        <view
          wx:for="{{units}}"
          wx:key="id"
          class="point-row"
          hover-class="point-row-hover"
          hover-stay-time="70"
          bindtap="onPickKnowledgeUnit"
          data-id="{{item.id}}"
          data-name="{{item.name}}"
        >
          <text class="point-name">{{item.name}}</text>
          <text class="point-chev">›</text>
        </view>
      </scroll-view>
    </view>
  </block>

  <block wx:else>
    <view class="nav-row nav-back-row" hover-class="nav-back-row-hover" hover-stay-time="70" bindtap="backFromList">
      <text class="nav-back">‹</text>
      <text class="nav-back-hint">返回上一级</text>
    </view>
    <view class="page-hero page-hero--compact">
      <view class="page-hero-accent"></view>
      <view class="page-hero-body">
        <text class="page-hero-title page-hero-title--unit">{{unitName}}</text>
        <text class="page-hero-meta muted" wx:if="{{!listLoading}}">共 {{pagination.total}} 题</text>
      </view>
    </view>
    <view wx:if="{{list.length}}" class="batch-bar">
      <view class="ui-strip-btn" hover-class="ui-strip-btn-hover" hover-stay-time="70" bindtap="onBatchDonePractice">本单元已做题一起练</view>
    </view>
    <view wx:if="{{listLoading}}" class="loading-pill muted">加载中…</view>
    <view wx:elif="{{!list.length}}" class="ios-card record-empty-card">
      <text class="record-empty-title">该单元暂无做题记录</text>
      <text class="muted record-empty-desc">去刷题后，做过的题会出现在这里，方便回头巩固。</text>
      <view class="btn-primary mt" hover-class="btn-primary-hover" hover-stay-time="70" bindtap="goBrowseQuiz">去刷题</view>
    </view>
    <view wx:else class="record-list-wrap">
      <view wx:for="{{list}}" wx:for-index="idx" wx:key="question_id" class="ios-card record-card">
        <view class="record-stem-row">
          <text class="record-seq">{{idx + 1}}.</text>
          <text class="record-stem">{{item.stem}}</text>
        </view>
        <view wx:if="{{item.options.length}}" class="record-options">
          <view wx:for="{{item.options}}" wx:for-item="opt" wx:for-index="optIdx" wx:key="optIdx" class="record-opt-row">
            <text class="record-opt-k">{{opt.option_key}}.</text>
            <text class="record-opt-t">{{opt.option_text}}</text>
          </view>
        </view>
        <text class="record-meta muted">{{item.question_type_text}} · 共 {{item.attempts}} 次 · 对 {{item.correct_count}} · 错 {{item.wrong_count}}</text>
        <view class="record-actions">
          <view class="ui-link-btn ui-link-btn--tint" hover-class="ui-link-btn-hover" hover-stay-time="70" catchtap="onRetryTap" data-qid="{{item.question_id}}">再练</view>
        </view>
      </view>
      <view wx:if="{{list.length && listLoadingMore}}" class="load-more-wrap">
        <text class="muted load-more-text">加载更多…</text>
      </view>
      <view wx:if="{{list.length && !hasMore}}" class="load-more-wrap">
        <text class="muted load-more-text">已加载全部</text>
      </view>
    </view>
  </block>
</view>
