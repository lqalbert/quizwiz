<view
  wx:if="{{visible}}"
  class="join-modal-mask"
  catchtouchmove="noop"
  bindtap="onMaskTap"
>
  <view class="join-modal-panel" catchtap="noop">
    <view class="join-modal-header">
      <view class="join-modal-header-text">
        <text class="join-modal-title">{{mode === 'pending' ? titlePending : titleForm}}</text>
        <text class="join-modal-lead">{{mode === 'pending' ? leadPending : leadForm}}</text>
      </view>
      <view
        wx:if="{{closable}}"
        class="join-modal-close"
        hover-class="join-modal-close-hover"
        hover-stay-time="70"
        bindtap="onCloseTap"
        aria-role="button"
        aria-label="关闭"
      >
        <text class="join-modal-close-icon">×</text>
      </view>
    </view>

    <block wx:if="{{mode === 'pending'}}">
      <view class="join-modal-pending">
        <view class="join-modal-pending-badge">
          <view class="join-modal-pending-dot"></view>
          <text class="join-modal-pending-label">等待教师审核</text>
        </view>
      </view>
      <view
        class="join-modal-action"
        hover-class="join-modal-action-hover"
        hover-stay-time="70"
        bindtap="onRefreshTap"
      >刷新审核状态</view>
    </block>

    <block wx:else>
      <view class="join-modal-fields">
        <view class="join-modal-field">
          <text class="join-modal-label">真实姓名</text>
          <view class="join-modal-input-box {{realNameFocus ? 'join-modal-input-box--focus' : ''}}">
            <input
              class="join-modal-input"
              placeholder="与学校登记一致，如：张三"
              placeholder-class="join-modal-ph"
              maxlength="64"
              value="{{realNameInput}}"
              bindinput="onRealNameInput"
              bindfocus="onRealNameFocus"
              bindblur="onRealNameBlur"
            />
          </view>
        </view>
        <view class="join-modal-field">
          <text class="join-modal-label">班级邀请码</text>
          <view class="join-modal-input-box {{inviteFocus ? 'join-modal-input-box--focus' : ''}}">
            <input
              class="join-modal-input join-modal-input--code"
              placeholder="向班主任获取"
              placeholder-class="join-modal-ph"
              maxlength="32"
              value="{{inviteInput}}"
              bindinput="onInviteInput"
              bindfocus="onInviteFocus"
              bindblur="onInviteBlur"
            />
          </view>
        </view>
      </view>
      <text class="join-modal-foot">提交后老师可在后台按真实姓名识别你</text>
      <button
        class="join-modal-action join-modal-action--btn"
        hover-class="join-modal-action-hover"
        hover-stay-time="70"
        loading="{{submitting}}"
        disabled="{{submitting}}"
        bindtap="onSubmitTap"
      >提交并加入班级</button>
    </block>
  </view>
</view>
