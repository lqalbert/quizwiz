/* 入班弹框 — 与「我的」页编辑弹窗同系，独立输入框 + 聚焦描边 */
.join-modal-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 500;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 48rpx 40rpx calc(48rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  background: rgba(0, 0, 0, 0.42);
}

.join-modal-panel {
  width: 100%;
  max-width: 620rpx;
  max-height: 86vh;
  overflow: hidden;
  display: flex;
  flex-direction: column;
  background: var(--ios-fill, #fff);
  border-radius: var(--ios-radius-card, 24rpx);
  box-shadow: 0 20rpx 72rpx rgba(0, 0, 0, 0.18);
  padding: 36rpx 32rpx calc(32rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.join-modal-header {
  position: relative;
  padding-right: 56rpx;
  margin-bottom: 28rpx;
  box-sizing: border-box;
}

.join-modal-header-text {
  min-width: 0;
}

.join-modal-title {
  display: block;
  font-size: 36rpx;
  font-weight: 700;
  letter-spacing: -0.02em;
  line-height: 1.25;
  color: var(--ios-label, #000);
  margin-bottom: 10rpx;
}

.join-modal-lead {
  display: block;
  font-size: 26rpx;
  line-height: 1.55;
  color: var(--ios-secondary, rgba(60, 60, 67, 0.72));
}

.join-modal-close {
  position: absolute;
  right: -8rpx;
  top: -4rpx;
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.join-modal-close-hover {
  background: rgba(60, 60, 67, 0.08);
}

.join-modal-close-icon {
  font-size: 44rpx;
  font-weight: 300;
  line-height: 1;
  color: var(--ios-tertiary, rgba(60, 60, 67, 0.42));
  margin-top: -2rpx;
}

.join-modal-fields {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.join-modal-field {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.join-modal-label {
  font-size: 24rpx;
  font-weight: 600;
  color: var(--ios-secondary, rgba(60, 60, 67, 0.72));
  letter-spacing: 0.02em;
  padding-left: 4rpx;
}

.join-modal-input-box {
  display: flex;
  align-items: center;
  min-height: 96rpx;
  padding: 0 24rpx;
  box-sizing: border-box;
  border-radius: 16rpx;
  background: rgba(60, 60, 67, 0.05);
  border: 2rpx solid rgba(60, 60, 67, 0.1);
  transition: border-color 0.15s ease, background 0.15s ease, box-shadow 0.15s ease;
}

.join-modal-input-box--focus {
  background: var(--ios-fill, #fff);
  border-color: var(--ios-tint, #007aff);
  box-shadow: 0 0 0 4rpx rgba(0, 122, 255, 0.12);
}

.join-modal-input {
  flex: 1;
  width: 100%;
  min-height: 92rpx;
  font-size: 32rpx;
  font-weight: 500;
  color: var(--ios-label, #000);
  line-height: 1.35;
  box-sizing: border-box;
}

.join-modal-input--code {
  font-weight: 600;
  letter-spacing: 0.1em;
}

.join-modal-ph {
  color: var(--ios-tertiary, rgba(60, 60, 67, 0.42));
  font-weight: 400;
  letter-spacing: 0;
}

.join-modal-foot {
  display: block;
  margin-top: 20rpx;
  font-size: 22rpx;
  line-height: 1.45;
  color: var(--ios-tertiary, rgba(60, 60, 67, 0.42));
  text-align: center;
}

.join-modal-pending {
  padding: 16rpx 0 8rpx;
}

.join-modal-pending-badge {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  padding: 28rpx 24rpx;
  border-radius: 16rpx;
  background: rgba(255, 149, 0, 0.08);
  border: 1rpx solid rgba(255, 149, 0, 0.18);
}

.join-modal-pending-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #ff9500;
  flex-shrink: 0;
}

.join-modal-pending-label {
  font-size: 28rpx;
  font-weight: 600;
  color: #c93400;
}

.join-modal-action {
  flex-shrink: 0;
  margin-top: 28rpx;
  height: 96rpx;
  border-radius: var(--ios-radius-btn, 20rpx);
  background: var(--ios-tint, #007aff);
  color: #fff;
  font-size: 32rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 6rpx 22rpx rgba(0, 122, 255, 0.26);
  box-sizing: border-box;
}

.join-modal-action--btn {
  width: 100%;
  padding: 0;
  margin-left: 0;
  margin-right: 0;
  line-height: 96rpx;
  border: none;
}

.join-modal-action--btn::after {
  border: none;
}

.join-modal-action-hover {
  opacity: 0.88;
}

.join-modal-action--btn[disabled] {
  opacity: 0.5;
  box-shadow: none;
}
