# 复制为仓库根目录的 local.dev.env 后填写（该文件已 .gitignore，勿提交）
# 然后在本目录执行: npm run setup && npm run dev
# 演示数据（docker 首次建库会自动执行 seed）：管理员手机 13800000001，密码为字面量 hash_admin（非 bcrypt 占位时与库中 password_hash 相同）

# ---- PostgreSQL（须与 docker-compose.dev.yml 中账号一致）----
DATABASE_URL=postgresql://quizwiz:quizwiz_local@127.0.0.1:5433/quizwiz

JWT_SECRET=dev-only-change-me
API_PORT=3000

# 本地联调：浏览器与小程序请求 API 的根（本机用 127.0.0.1；真机调试手机填电脑局域网 IP）
UPLOAD_PUBLIC_BASE=http://127.0.0.1:3000

# 教师端 Vite：留空则走代理到本机 API（见 teacher-admin/vite.config.ts）
VITE_API_BASE_URL=

# 小程序开发时请求的 API 根（与 UPLOAD_PUBLIC_BASE 通常相同；真机改为 http://你的电脑IP:3000）
MINIPROGRAM_DEV_API_BASE=http://127.0.0.1:3000

# 微信登录（与 project.config.json 的 appid 一致；不填则登录接口不可用）
WECHAT_MINI_APPID=
WECHAT_MINI_SECRET=

# 联调必开：允许任意 Origin（仅本地 .env 使用，切勿用于生产）
QUIZWIZ_DEV_CORS_ANY=1
